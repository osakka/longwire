#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# longwire -- the Control Panel pane for longwire, the layer-2 mesh VPN: who you are, who is ringing, who you are
# connected to, the line you are on, and how this machine answers. It speaks to the node you started yourself through
# `lw`, the same verbs the command uses, and to nothing else: it never reads the seed, never asks for privilege, and a
# node that runs as a service under another user is shown, not driven (docs/adr/0030-three-surfaces-one-engine.md).
#
# A ring is answered here, in the Calls rows, while the pane is open. The pane is where the connection is set up and turned on and
# off: a profile (switchboard, token, attach mode, interface, name), a Turn on that makes the jack if it has to, and a Turn off.

strict

app longwire "The Control Panel pane for longwire: dial, answer, see your line" 0.5.24
# modules: longwire
# needs: cli/longwire
command -v cp_pane > /dev/null && cp_pane longwire "Longwire" "☎" app

# The connection the person chose lives in the profiles file (~/.config/longwire/profiles, `longwire profile`), the same one the
# command and the menu bar read. The pane only remembers which profile it is showing.
DT_LW_PROFILE="${DT_LW_PROFILE-}"
# Whether the menu bar item (menubar/longwire.hibr, in the same bundle) is shown: Menu Bar Items turns it too.
DT_LWBAR="${DT_LWBAR-1}"
# Phone Style: modern (a handset) or classic (a rotary desk phone), for glyph sets that draw the telephone (Blit's); it is a row only where there is a choice.
DT_LWSTYLE="${DT_LWSTYLE-modern}"
DT_LW_NODE="${DT_LW_NODE--}"
command -v dt_keep > /dev/null && dt_keep DT_LW_PROFILE DT_LWBAR DT_LWSTYLE DT_LW_NODE

LWP_POLICIES=(ask known auto never)
LWP_STYLES=(modern classic)
LWP_ATTACHES=(jack splice)

# The last status read, and when. _rows runs every frame, and a read of the node is a round trip, so it is kept for a second.
declare -g LWP_S LWP_T=-100 LWP_UP=0 LWP_SVC LWP_SVCT=-100 LWP_PHRASE_SHOWN= LWP_SOCK= LWP_NODES= LWP_NODEST=-100
LWP_NODEA=()
LWP_SITE=
LWP_SELF="${LONGWIRE_SELF_VERSION:-0.5.24}"	# this file's version: the catalogue's. The engine is the package's, and a running node has its own.
LWP_NOTEA=()
LWP_NOTEST=-100

# Bytes a connection has carried, in the units a person reads: decimal, one place.
fn lwp_bytes(n) {
	if [ "$n" -ge 1000000000 ]; then
		ret "$((n / 1000000000)).$((n % 1000000000 / 100000000)) GB"
	elif [ "$n" -ge 1000000 ]; then
		ret "$((n / 1000000)).$((n % 1000000 / 100000)) MB"
	elif [ "$n" -ge 1000 ]; then
		ret "$((n / 1000)).$((n % 1000 / 100)) kB"
	else
		ret "$n B"
	fi
}

# A rate in bits a second, from bytes a second.
fn lwp_rate(bps) {
	if [ "$bps" -ge 1000000000 ]; then
		ret "$((bps / 1000000000)).$((bps % 1000000000 / 100000000)) Gbit/s"
	elif [ "$bps" -ge 1000000 ]; then
		ret "$((bps / 1000000)).$((bps % 1000000 / 100000)) Mbit/s"
	elif [ "$bps" -ge 1000 ]; then
		ret "$((bps / 1000)).$((bps % 1000 / 100)) kbit/s"
	else
		ret "$bps bit/s"
	fi
}

# What each connection carried at the last read, and the rate since the one before: the node counts bytes and keeps no
# clock, so the rate is made here, from two reads. A counter that went down is a connection that started again, and has no rate yet.
declare -gA LWP_RX LWP_TX LWP_MS LWP_RRATE LWP_TRATE

fn lwp_rates() {
	local i cnt num rx tx now dt

	now := dt_ms
	cnt := json len LWP_S .peers
	for ((i = 0; i < ${cnt:-0}; i++)); do
		num := lwp_get ".peers[$i].number"
		[ -n "$num" ] || continue
		rx := lwp_get ".peers[$i].rx_bytes" 0
		tx := lwp_get ".peers[$i].tx_bytes" 0
		dt=$((now - ${LWP_MS[$num]:-$now}))
		if [ -n "${LWP_MS[$num]-}" ] && [ "$dt" -gt 0 ] && [ "$rx" -ge "${LWP_RX[$num]:-0}" ] && [ "$tx" -ge "${LWP_TX[$num]:-0}" ]; then
			LWP_RRATE[$num]=$(((rx - LWP_RX[$num]) * 8000 / dt))
			LWP_TRATE[$num]=$(((tx - LWP_TX[$num]) * 8000 / dt))
		else
			unset LWP_RRATE[$num] LWP_TRATE[$num]
		fi
		LWP_RX[$num]=$rx
		LWP_TX[$num]=$tx
		LWP_MS[$num]=$now
	done
}

# Which nodes answer here: this machine's own (written "-") and the services under /run/longwire/INSTANCE/ctl, which the group longwire may use
# (ADR 0032). Looked at every five seconds, or at once when there is none.
fn lwp_nodes() {
	local f

	[ -z "$LWP_NODES" ] || [ $((SECONDS - LWP_NODEST)) -ge 5 ] || return 0
	LWP_NODEST=$SECONDS
	LWP_NODES=
	LWP_NODEA=()
	if lw status > /dev/null 2>&1; then
		LWP_NODES=-
		LWP_NODEA+=(-)
	fi
	for f in "${LW_RUN:-/run}"/longwire/*/ctl; do
		[ -S "$f" ] || continue
		if lw status --sock "$f" > /dev/null 2>&1; then
			LWP_NODES="${LWP_NODES:+$LWP_NODES }$f"
			LWP_NODEA+=("$f")
		fi
	done
}

# What a node is called in the pane.
fn lwp_nodename(n) {
	if [ "$n" = - ]; then
		ret "this machine"
	else
		n=${n%/ctl}
		ret "service ${n##*/}"
	fi
}

# Read the status of the chosen node into LWP_S, at most once a second. LWP_UP says whether there was a node to read. With several nodes the
# one chosen in the Node row is read (DT_LW_NODE); one that is gone gives way to the first that answers.
fn lwp_poll() {
	local st want f

	[ $((SECONDS - LWP_T)) -ge 1 ] || return 0
	LWP_T=$SECONDS
	lwp_nodes
	LWP_SOCK=
	want=$DT_LW_NODE
	case " $LWP_NODES " in
	*" $want "*) ;;
	*) want=${LWP_NODES%% *} ;;
	esac
	if [ -z "$want" ]; then
		LWP_UP=0
		return 0
	fi
	[ "$want" = - ] && f= || f=$want
	if st := lw status ${f:+--sock "$f"} 2> /dev/null && json parse LWP_S "$st" 2> /dev/null; then
		LWP_UP=1
		LWP_SOCK=$f
		lwp_rates
		return 0
	fi
	LWP_UP=0
}

# Versions are a.b.c. 0 if the first is older than the second; an empty first one is older than anything.
fn lwp_ver_lt(a, b) {
	local a1 a2 a3 b1 b2 b3 r

	[ -n "$a" ] || return 0
	a1=${a%%.*}; r=${a#*.}; a2=${r%%.*}; a3=${r#*.}
	b1=${b%%.*}; r=${b#*.}; b2=${r%%.*}; b3=${r#*.}
	case $a1$a2$a3$b1$b2$b3 in *[!0-9]*) return 1 ;; esac
	[ $((a1 * 1000000 + a2 * 1000 + a3)) -lt $((b1 * 1000000 + b2 * 1000 + b3)) ]
}

# What is out of step between the pane, the installed engine and the running node, in words (the same as `longwire doctor`); looked at every ten seconds.
fn lwp_notes() {
	local mod run v

	[ $((SECONDS - LWP_NOTEST)) -ge 10 ] || return 0
	LWP_NOTEST=$SECONDS
	LWP_NOTEA=()
	mod=
	if v := lw version 2> /dev/null; then
		mod=$v
	fi
	if [ -z "$mod" ] || lwp_ver_lt "$mod" "$LWP_SELF"; then
		LWP_NOTEA+=("The longwire package (${mod:-older than 0.5.15}) is older than this pane ($LWP_SELF): update the package (apt, dnf or pacman)")
	elif lwp_ver_lt "$LWP_SELF" "$mod"; then
		LWP_NOTEA+=("This pane ($LWP_SELF) is older than the installed engine ($mod): catalogue refresh, then install longwire")
	fi
	if [ "$LWP_UP" = 1 ]; then
		run := lwp_get .version
		if [ "$run" != "$mod" ]; then
			LWP_NOTEA+=("The running node has engine ${run:-older than 0.5.10}, the installed one is ${mod:-older than 0.5.15}: turn it off and on")
		fi
	fi
}

# Whether longwire runs here as a service, under another user: read-only, and looked at every ten seconds.
fn lwp_service() {
	local u rest

	[ $((SECONDS - LWP_SVCT)) -ge 10 ] || return 0
	LWP_SVCT=$SECONDS
	LWP_SVC=
	command -v systemctl > /dev/null || return 0
	LWP_SVC=$(systemctl list-units 'longwire@*' --state=active --no-legend --plain 2> /dev/null | while read -r u rest; do printf '%s ' "${u%.service}"; done)
}

# One value from the status, or the second word if it is not there.
fn lwp_get(path, def = "") {
	local v

	if v := json get LWP_S "$path" 2> /dev/null; then
		ret "$v"
	else
		ret "$def"
	fi
}

# The answer policy: the file `longwire answer` writes and `longwire up` reads at each ring.
fn lwp_policy_file() {
	ret "${LW_DIR:-$HOME/.longwire}/answer"
}

fn lwp_policy() {
	local f p=ask

	f := lwp_policy_file
	[ -r "$f" ] && read -r p < "$f"
	case $p in ask | known | auto | never) ;; *) p=ask ;; esac
	ret "$p"
}

# --- the profiles --------------------------------------------------------------------------------------------------------

# What the file says, read at most once a second (the rows are built every frame). A token is not kept here, only how long it is.
declare -gA LWP_PF
declare -ga LWP_PNAMES=()
declare -g LWP_PDEF= LWP_PT=-100 LWP_BUSY=0 LWP_JOB= LWP_ON=

fn lwp_pfile() {
	ret "${XDG_CONFIG_HOME:-$HOME/.config}/longwire/profiles"
}

fn lwp_profiles(force = "") {
	local f k eq v cur=

	[ -n "$force" ] || [ $((SECONDS - LWP_PT)) -ge 1 ] || return 0
	LWP_PT=$SECONDS
	LWP_PF=()
	LWP_PNAMES=()
	LWP_PDEF=
	f := lwp_pfile
	[ -r "$f" ] || return 0
	while read -r k eq v; do
		case $k in
		default) LWP_PDEF=$eq ;;
		profile) cur=$eq; LWP_PNAMES+=("$cur") ;;
		token) [ -n "$cur" ] && LWP_PF["$cur.token"]=${#v} ;;
		switchboard | attach | interface | address | keep_jack | name | listed | answer) [ -n "$cur" ] && LWP_PF["$cur.$k"]=$v ;;
		esac
	done < "$f"
}

# The profile the pane shows: the one chosen if it is still there, else the default, else the first, else none.
fn lwp_cur() {
	local n

	lwp_profiles
	for n in "${LWP_PNAMES[@]}"; do
		[ "$n" = "$DT_LW_PROFILE" ] && { ret "$n"; return 0; }
	done
	[ -n "$LWP_PDEF" ] && { ret "$LWP_PDEF"; return 0; }
	ret "${LWP_PNAMES[0]:-}"
}

# Change a field of the profile shown, making the first one (called home) if there is none. `longwire profile` does the
# writing and the checking, so what the pane saves is what the command would have.
fn lwp_pset(key, value) {
	local n out

	n := lwp_cur
	[ -n "$n" ] || n=home
	if out=$(longwire profile set "$n" "$key=$value" 2>&1); then
		DT_LW_PROFILE=$n
		lwp_profiles 1
		return 0
	fi
	dt_notep high "%s" "$out"
	return 1
}

fn lwp_row(int w, int n, kind, text, val, key) {
	CP[$w][$n]["kind"]=$kind
	CP[$w][$n]["text"]=$text
	CP[$w][$n]["val"]=$val
	CP[$w][$n]["key"]=$key
}

fn longwire_rows(int w) {
	local n=0 i cnt num name state p we call phr nm sw nat full path age yn pol rx tx rr tr rb tb tk nodename note

	if ! need longwire 2> /dev/null; then
		cp_absent "$w" "the longwire module"
		ret 1
	fi
	lwp_poll
	lwp_notes
	dt_want 1000
	if [ "${#LWP_NOTEA[@]}" -gt 0 ]; then
		lwp_row "$w" "$n" head "Out of step" "" none; n=$((n + 1))
		for note in "${LWP_NOTEA[@]}"; do
			lwp_row "$w" "$n" action "$note" "" none; n=$((n + 1))
		done
	fi
	if [ "$LWP_UP" != 1 ]; then
		lwp_service
		lwp_row "$w" "$n" head "Longwire is off" "" none; n=$((n + 1))
		if [ -n "$LWP_SVC" ]; then
			lwp_row "$w" "$n" action "A service node runs here" "${LWP_SVC}(systemctl)" svc; n=$((n + 1))
			lwp_row "$w" "$n" action "  to use it from here" "join the group longwire, then log in again" none; n=$((n + 1))
		fi
		p := lwp_cur
		lwp_row "$w" "$n" head "Connection" "" none; n=$((n + 1))
		if [ -n "$p" ]; then
			lwp_row "$w" "$n" set "Profile" "$p" profile; n=$((n + 1))
		else
			lwp_row "$w" "$n" action "Profile" "none yet: fill in the rows below" none; n=$((n + 1))
		fi
		lwp_row "$w" "$n" action "Switchboard" "${LWP_PF[$p.switchboard]:-HOST:PORT/KEY}" sb; n=$((n + 1))
		if [ -n "${LWP_PF[$p.token]-}" ]; then
			tk="set (${LWP_PF[$p.token]} characters)"
		else
			tk=none
		fi
		lwp_row "$w" "$n" action "Token" "$tk" token; n=$((n + 1))
		lwp_row "$w" "$n" set "Attach" "${LWP_PF[$p.attach]:-jack}" attach; n=$((n + 1))
		lwp_row "$w" "$n" action "Interface" "${LWP_PF[$p.interface]:-lw0}" iface; n=$((n + 1))
		[ "${LWP_PF[$p.attach]:-jack}" = jack ] && { lwp_row "$w" "$n" action "Address" "${LWP_PF[$p.address]:-none}" address; n=$((n + 1)); }
		if [ "${LWP_PF[$p.attach]:-jack}" = jack ]; then
			CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Keep the jack when turned off"; CP[$w][$n]["wtype"]=bool
			CP[$w][$n]["val"]=on; [ "${LWP_PF[$p.keep_jack]-}" = no ] && CP[$w][$n]["val"]=off
			CP[$w][$n]["key"]=keepjack; n=$((n + 1))
		fi
		lwp_row "$w" "$n" action "Name" "${LWP_PF[$p.name]:-none}" name; n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="List in the directory"; CP[$w][$n]["wtype"]=bool
		CP[$w][$n]["val"]=off; [ "${LWP_PF[$p.listed]-}" = yes ] && CP[$w][$n]["val"]=on
		CP[$w][$n]["key"]=listed; n=$((n + 1))
		lwp_row "$w" "$n" set "When a call rings" "${LWP_PF[$p.answer]:-ask}" ppolicy; n=$((n + 1))
		if dt_has lwb_tick; then
			CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Longwire on the Menu Bar"; CP[$w][$n]["wtype"]=bool
			CP[$w][$n]["val"]=off; [ "$DT_LWBAR" = 1 ] && CP[$w][$n]["val"]=on
			CP[$w][$n]["key"]=barswitch; n=$((n + 1))
		fi
		if [ -n "${GL[phoneoff]-}" ]; then
			lwp_row "$w" "$n" set "Phone Style" "$DT_LWSTYLE" lwstyle; n=$((n + 1))
		fi
		if [ "$LWP_BUSY" = 1 ]; then
			lwp_row "$w" "$n" action "Turning on${GL[ellipsis]}" "" none; n=$((n + 1))
		else
			lwp_row "$w" "$n" action "Turn on" "" on; n=$((n + 1))
		fi
		lwp_row "$w" "$n" action "New profile${GL[ellipsis]}" "" newprofile; n=$((n + 1))
		[ -n "$p" ] && { lwp_row "$w" "$n" action "Rename profile $p" "" renprofile; n=$((n + 1)); }
		[ -n "$p" ] && { lwp_row "$w" "$n" action "Remove profile $p" "" rmprofile; n=$((n + 1)); }
		ret "$n"
		return 0
	fi

	num := lwp_get .full
	name := lwp_get .name
	sw := lwp_get .switchboard
	nat := lwp_get .nat
	lwp_row "$w" "$n" head "This node" "" none; n=$((n + 1))
	case $LWP_NODES in			# more than one node answers here: choose which this pane shows
	*" "*) nodename := lwp_nodename "${LWP_SOCK:--}"; lwp_row "$w" "$n" set "Node" "$nodename" lwnode; n=$((n + 1)) ;;
	esac
	lwp_row "$w" "$n" action "Number" "${num:-waiting for the switchboard}" none; n=$((n + 1))
	lwp_row "$w" "$n" action "Name" "${name:-none}" none; n=$((n + 1))
	lwp_row "$w" "$n" action "Switchboard" "$sw" none; n=$((n + 1))
	lwp_row "$w" "$n" action "NAT" "$nat" none; n=$((n + 1))
	if [ -n "$LWP_SOCK" ]; then
		lwp_row "$w" "$n" action "Runs as" "a service (longwire@${LWP_SOCK%/ctl})" none; n=$((n + 1))
		lwp_row "$w" "$n" action "Stop the service" "" stopsvc; n=$((n + 1))
	else
		lwp_row "$w" "$n" action "Turn off" "" stop; n=$((n + 1))
	fi

	lwp_row "$w" "$n" head "Calls" "" none; n=$((n + 1))
	cnt := json len LWP_S .calls
	for ((i = 0; i < ${cnt:-0}; i++)); do
		state := lwp_get ".calls[$i].state"
		we := lwp_get ".calls[$i].we_called"
		call := lwp_get ".calls[$i].call"
		num := lwp_get ".calls[$i].number"
		nm := lwp_get ".calls[$i].name"
		phr := lwp_get ".calls[$i].phrase"
		if [ "$state" = ringing ] && [ "$we" != true ]; then
			lwp_row "$w" "$n" action "$num rings${nm:+ ($nm, a claim)}" "pick up?" "ring:$call"; n=$((n + 1))
			lwp_row "$w" "$n" action "  safety phrase" "${phr:-comes once connected}" none; n=$((n + 1))
			lwp_row "$w" "$n" action "  decline" "" "rej:$call"; n=$((n + 1))
		elif [ "$state" != up ]; then
			lwp_row "$w" "$n" action "$num" "$state" "hang:$num"; n=$((n + 1))
		fi
	done
	cnt := json len LWP_S .peers
	for ((i = 0; i < ${cnt:-0}; i++)); do
		num := lwp_get ".peers[$i].number"
		state := lwp_get ".peers[$i].state"
		path := lwp_get ".peers[$i].path"
		age := lwp_get ".peers[$i].age"
		[ -n "$num" ] || continue
		lwp_row "$w" "$n" action "$num" "$state, $path${age:+, ${age}s}" "hang:$num"; n=$((n + 1))
		if [ -n "${LWP_RRATE[$num]-}" ]; then
			rx := lwp_get ".peers[$i].rx_bytes" 0
			tx := lwp_get ".peers[$i].tx_bytes" 0
			rr := lwp_rate "${LWP_RRATE[$num]}"
			tr := lwp_rate "${LWP_TRATE[$num]}"
			rb := lwp_bytes "$rx"
			tb := lwp_bytes "$tx"
			lwp_row "$w" "$n" action "  rx $rr   tx $tr" "$rb in, $tb out" none; n=$((n + 1))
		fi
	done
	lwp_row "$w" "$n" action "Dial${GL[ellipsis]}" "" dial; n=$((n + 1))

	lwp_row "$w" "$n" head "Line" "" none; n=$((n + 1))
	yn := json type LWP_S .line
	if [ "$yn" = object ]; then
		local mg id
		id := lwp_get .line.id
		mg := lwp_get .line.managed false
		lwp_row "$w" "$n" action "Line $id" "$([ "$mg" = true ] && echo 'managed by an operator' || echo 'members vouch for members')" none; n=$((n + 1))
		cnt := json len LWP_S .line.members
		for ((i = 0; i < ${cnt:-0}; i++)); do
			num := lwp_get ".line.members[$i].number"
			state := lwp_get ".line.members[$i].state"
			if [ "$state" = you ] || [ "$mg" = true ]; then
				lwp_row "$w" "$n" action "$num" "$state" none
			else
				lwp_row "$w" "$n" action "$num" "$state" "evict:$num"
			fi
			n=$((n + 1))
		done
	else
		lwp_row "$w" "$n" action "Not on a line" "a call to a second node starts one" none; n=$((n + 1))
	fi

	lwp_row "$w" "$n" head "Answering" "" none; n=$((n + 1))
	if [ -n "$LWP_SOCK" ]; then
		lwp_row "$w" "$n" action "When a call rings" "set by the service (/etc/longwire)" none; n=$((n + 1))
	else
		pol := lwp_policy
		lwp_row "$w" "$n" set "When a call rings" "$pol" policy; n=$((n + 1))
	fi
	if dt_has lwb_tick; then
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Longwire on the Menu Bar"; CP[$w][$n]["wtype"]=bool
		CP[$w][$n]["val"]=off; [ "$DT_LWBAR" = 1 ] && CP[$w][$n]["val"]=on
		CP[$w][$n]["key"]=barswitch; n=$((n + 1))
	fi
	if [ -n "${GL[phoneoff]-}" ]; then
		lwp_row "$w" "$n" set "Phone Style" "$DT_LWSTYLE" lwstyle; n=$((n + 1))
	fi
	ret "$n"
}

# --- what a row does -------------------------------------------------------------------------------------------------

# A question that has been asked and not yet answered: dt_confirm runs a function of no arguments.
declare -g LWP_PEND_KIND= LWP_PEND_ARG= LWP_PEND_ARG2=

fn lwp_run(what, arg = "") {
	# a failed verb leaves its reason in $ERRMSG
	if lw "$what" ${arg:+"$arg"} ${LWP_SOCK:+--sock "$LWP_SOCK"} > /dev/null 2>&1; then
		return 0
	fi
	dt_notep high "longwire: %s" "${ERRMSG:-$what failed}"
	return 1
}

fn lwp_yes() {
	case $LWP_PEND_KIND in
	pickup) lwp_run pickup "$LWP_PEND_ARG" ;;
	hangup) lwp_run hangup "$LWP_PEND_ARG" ;;
	evict) lwp_run evict "$LWP_PEND_ARG" ;;
	stop)
		lwp_run stop
		lwp_dropjack ;;
	rmprofile)
		longwire profile remove "$LWP_PEND_ARG" > /dev/null 2>&1
		lwp_profiles 1 ;;
	stopsvc)
		LWP_SITE=
		LWP_BUSY=1
		LWP_JOB := dt_ptyjob longwire site lwp_sitedone lwp_pkprompt longwire site --stop "$LWP_PEND_ARG" ;;
	esac
	LWP_T=-100
}

fn lwp_ask(kind, arg, msg) {
	LWP_PEND_KIND=$kind
	LWP_PEND_ARG=$arg
	dt_confirm "$msg" lwp_yes
}

# The Dial dialog's answer.
fn lwp_dialled(text, int? id = "") {
	text=${text//[[:space:]]/}
	[ -n "$text" ] || return 1
	lwp_run dial "$text"
	LWP_T=-100
	return 0
}

fn lwp_setsb(text, int? id = "") { text=${text//[[:space:]]/}; lwp_pset switchboard "$text"; return 0; }
fn lwp_setiface(text, int? id = "") { text=${text//[[:space:]]/}; lwp_pset interface "$text"; return 0; }
fn lwp_setaddress(text, int? id = "") { text=${text//[[:space:]]/}; lwp_pset address "$text"; return 0; }
fn lwp_setname(text, int? id = "") { lwp_pset name "$text"; return 0; }
fn cp_set_lwpolicy(int? id = "", value = "") { lwp_setpolicy "$value"; }
fn cp_set_lwppolicy(int? id = "", value = "") { lwp_pset answer "$value"; }
fn cp_set_lwattach(int? id = "", value = "") { lwp_pset attach "$value"; }
fn cp_set_lwstyle(int? id = "", value = "") { DT_LWSTYLE=$value; dt_has lwb_refresh && lwb_refresh; cp_save; }
fn cp_set_lwprofile(int? id = "", value = "") {
	DT_LW_PROFILE=$value
	longwire profile default "$value" > /dev/null 2>&1		# the command and the menu bar use the default one: it is the one shown here
	lwp_profiles 1
	cp_save
}

# The token is typed into a masked dialog and goes to `longwire profile token` on its standard input, never on a command line.
fn lwp_settoken(text, int? id = "") {
	local n out

	n := lwp_cur
	if [ -z "$n" ]; then
		lwp_pset interface lw0 || return 0
		n := lwp_cur
	fi
	text=${text//[[:space:]]/}
	if out=$(printf '%s\n' "$text" | longwire profile token "$n" 2>&1); then
		lwp_profiles 1
	else
		dt_notep high "%s" "$out"
	fi
	return 0
}

fn lwp_newprofile(text, int? id = "") {
	local out

	text=${text//[[:space:]]/}
	[ -n "$text" ] || return 0
	if out=$(longwire profile set "$text" interface=lw0 2>&1); then
		DT_LW_PROFILE=$text
		lwp_profiles 1
		cp_save
	else
		dt_notep high "%s" "$out"
	fi
	return 0
}

fn lwp_renameprofile(text, int? id = "") {
	local out old

	text=${text//[[:space:]]/}
	[ -n "$text" ] || return 0
	old := lwp_cur
	if out=$(longwire profile rename "$old" "$text" 2>&1); then
		[ "$DT_LW_PROFILE" = "$old" ] && DT_LW_PROFILE=$text
		lwp_profiles 1
		cp_save
	else
		dt_notep high "%s" "$out"
	fi
	return 0
}

fn lwp_setpolicy(p) {
	local f

	f := lwp_policy_file
	mkdir -p "${f%/*}" 2> /dev/null
	printf '%s\n' "$p" > "$f"
}

# --- turning on ---------------------------------------------------------------------------------------------------------------
# The jack (a tap device) is made by a small root helper that polkit lets the person run after one password, so nobody types
# `ip tuntap`. The password is asked for here, in the desktop, the way the Networks item asks for its own: pkexec runs on a pty
# and its "Password:" is answered from a masked dialog.

fn lwp_pkprompt(int n, text) {
	case $text in *"assword: ") ;; *) return 1 ;; esac
	[ -n "${DTJ[$n]["asking"]}" ] && return 0
	DTJ[$n]["asking"]=1
	dt_ask "Authentication" "Password:" "" lwp_pwgive "To create the network device longwire uses, once: the administrator's (root) password" 1 76 lwp_pwcancel > /dev/null
	return 0
}

fn lwp_pwgive(v, int id) {
	local n=$LWP_JOB

	[ -n "$n" ] && [ -n "${DTJ[$n]["pty"]}" ] || return 0
	pty write "${DTJ[$n]["pty"]}" "$v"$'\r'
	DTJ[$n]["asking"]=
	return 0
}

fn lwp_pwcancel(int id) {
	local n=$LWP_JOB

	[ -n "$n" ] && [ -n "${DTJ[$n]["pty"]}" ] || return 0
	DTJ[$n]["cancelled"]=1
	DTJ[$n]["asking"]=
	pty write "${DTJ[$n]["pty"]}" $'\003' 2> /dev/null
	return 0
}

# The jack was asked for and the job has ended: go on to turn the node on, or say why not.
fn lwp_jackdone(int n, int st) {
	local why=

	LWP_JOB=
	if [ "$st" = 0 ]; then
		lwp_launch "$LWP_ON"
		return 0
	fi
	LWP_BUSY=0
	if [ -n "${DTJ[$n]["cancelled"]}" ]; then
		dt_notep low "Cancelled"
	else
		why := dt_joblast "$n"
		dt_notep high "Could not make the jack: %s" "${why:-exit $st}"
	fi
	return 0
}

# After turning off, a profile that says keep_jack=no takes the jack away too: one more password, unless one was given a moment ago.
fn lwp_dropjack() {
	local p iface

	p := lwp_cur
	[ -n "$p" ] || return 0
	[ "${LWP_PF[$p.keep_jack]-}" = no ] && [ "${LWP_PF[$p.attach]:-jack}" = jack ] || return 0
	iface=${LWP_PF[$p.interface]:-lw0}
	[ -d "/sys/class/net/$iface" ] || return 0
	LWP_SITE=
	LWP_BUSY=1
	LWP_JOB := dt_ptyjob longwire jack lwp_jackgone lwp_pkprompt longwire jack --remove "$iface"
}

fn lwp_jackgone(int n, int st) {
	local why=

	LWP_JOB=
	LWP_BUSY=0
	LWP_T=-100
	if [ "$st" = 0 ]; then
		dt_notep low "The jack is removed"
	elif [ -n "${DTJ[$n]["cancelled"]}" ]; then
		dt_notep low "Cancelled: the jack stays"
	else
		why := dt_joblast "$n"
		dt_notep high "Could not remove the jack: %s" "${why:-exit $st}"
	fi
	return 0
}

# The site node was asked for (or stopped) and the job has ended: follow the service, or say why not.
fn lwp_sitedone(int n, int st) {
	local why=

	LWP_JOB=
	LWP_BUSY=0
	LWP_T=-100
	LWP_NODEST=-100
	if [ "$st" = 0 ]; then
		if [ -n "$LWP_SITE" ]; then
			DT_LW_NODE="${LW_RUN:-/run}/longwire/$LWP_SITE/ctl"
			cp_save
			dt_notep low "Site node running on %s: the Node row follows it" "$LWP_SITE"
		else
			dt_notep low "The site node is stopped"
		fi
		return 0
	fi
	if [ -n "${DTJ[$n]["cancelled"]}" ]; then
		dt_notep low "Cancelled"
	else
		why := dt_joblast "$n"
		dt_notep high "Could not %s the site node: %s" "${LWP_SITE:+make}${LWP_SITE:-stop}" "${why:-exit $st}"
	fi
	return 0
}

# `longwire on` in the background of the desktop: it starts the node detached and says what number it got.
fn lwp_launch(p) {
	LWP_BUSY=1
	dt_job longwire "" lwp_ondone longwire on "$p" > /dev/null
	LWP_T=-100
}

fn lwp_ondone(int n, int st) {
	local f line all= one

	LWP_BUSY=0
	for one in out err; do
		f := dt_jobfile "$n" "$one"
		[ -r "$f" ] || continue
		while IFS= read -r line; do
			line=${line#longwire: }
			[ -n "$line" ] && all="${all:+$all | }$line"
		done < "$f"
	done
	all=${all:0:300}
	if [ "$st" = 0 ]; then
		dt_notep low "%s" "$all"
	else
		dt_notep high "Longwire did not turn on: %s" "${all:-exit $st}"
	fi
	LWP_T=-100
	return 0
}

# Is the address already on the device? (Asked without privilege, so the password is only asked when it must be.)
fn lwp_hasaddr(iface, addr) {
	local pid=

	if [ "$addr" = dhcp ]; then			# a DHCP client of ours is running on it, or it has an IPv4 address
		read -r pid < "${LONGWIRE_RUN:-/run/longwire}/dhcp-$iface.pid" 2> /dev/null
		[ -n "$pid" ] && [ -d "/proc/$pid" ] && return 0
		PATH=$PATH:/usr/sbin:/sbin ip -4 -o addr show dev "$iface" 2> /dev/null | grep -q ' inet '
		return
	fi
	PATH=$PATH:/usr/sbin:/sbin ip -4 -o addr show dev "$iface" 2> /dev/null | grep -q " ${addr%/*}/"
}

fn lwp_turnon(int w) {
	local p sb attach iface addr

	if ! command -v longwire > /dev/null; then
		dt_notep high "longwire is not installed. Find it in the Catalogue (Commands)."
		return 1
	fi
	[ "$LWP_BUSY" = 0 ] || return 0
	p := lwp_cur
	sb=${LWP_PF[$p.switchboard]-}
	if [ -z "$p" ] || [ -z "$sb" ]; then
		dt_notep high "Set the switchboard first (HOST:PORT/KEY)."
		return 1
	fi
	attach=${LWP_PF[$p.attach]:-jack}
	iface=${LWP_PF[$p.interface]:-lw0}
	if [ "$attach" = splice ]; then
		# a site node is a service: one password makes it (longwire site), and the pane then follows it through its control socket (the Node row)
		LWP_ON=$p
		LWP_SITE=$iface
		LWP_BUSY=1
		LWP_JOB := dt_ptyjob longwire site lwp_sitedone lwp_pkprompt longwire site "$iface" "$p"
		[ -n "$LWP_JOB" ] || { LWP_BUSY=0; dt_notep high "Could not start pkexec"; return 1; }
		dt_notep low "Making this machine a site node for %s${GL[ellipsis]}" "$iface"
		return 0
	fi
	LWP_ON=$p
	addr=${LWP_PF[$p.address]-}
	if [ "$attach" = jack ] && { [ ! -d "/sys/class/net/$iface" ] || { [ -n "$addr" ] && ! lwp_hasaddr "$iface" "$addr"; }; }; then
		LWP_BUSY=1
		LWP_JOB := dt_ptyjob longwire jack lwp_jackdone lwp_pkprompt longwire jack ${addr:+--address "$addr"} "$iface"
		[ -n "$LWP_JOB" ] || { LWP_BUSY=0; dt_notep high "Could not start pkexec"; return 1; }
		dt_notep low "Making the jack $iface${GL[ellipsis]}"
		return 0
	fi
	lwp_launch "$p"
	dt_notep low "Turning on${GL[ellipsis]}"
}

# A ringing call, found again in the last status by its id, so that what is asked is what the node reported a moment ago and
# not something carried in a row's key.
fn lwp_ring(call) {
	local i cnt num phr nm c

	cnt := json len LWP_S .calls
	for ((i = 0; i < ${cnt:-0}; i++)); do
		c := lwp_get ".calls[$i].call"
		[ "$c" = "$call" ] || continue
		num := lwp_get ".calls[$i].number"
		phr := lwp_get ".calls[$i].phrase"
		nm := lwp_get ".calls[$i].name"
		LWP_PEND_KIND=pickup
		LWP_PEND_ARG=$call
		dt_confirm "$num${nm:+ ($nm, a claim)} rings. ${phr:+Safety phrase: $phr. }${phr:-The safety phrase comes once you are connected: compare it with theirs. }Pick up?" lwp_yes
		return 0
	done
	dt_notep low "That call has ended."
}

fn longwire_do(int w, k, int dir) {
	local v c rest p

	case $k in
	policy)
		v := lwp_policy
		v := cp_next "$v" "$dir" "${LWP_POLICIES[@]}"
		lwp_setpolicy "$v" ;;
	ppolicy)
		p := lwp_cur
		v=${LWP_PF[$p.answer]:-ask}
		v := cp_next "$v" "$dir" "${LWP_POLICIES[@]}"
		lwp_pset answer "$v" ;;
	attach)
		p := lwp_cur
		v=${LWP_PF[$p.attach]:-jack}
		v := cp_next "$v" "$dir" "${LWP_ATTACHES[@]}"
		lwp_pset attach "$v" ;;
	keepjack)
		p := lwp_cur
		if [ "${LWP_PF[$p.keep_jack]-}" = no ]; then lwp_pset keep_jack yes; else lwp_pset keep_jack no; fi ;;
	listed)
		p := lwp_cur
		if [ "${LWP_PF[$p.listed]-}" = yes ]; then lwp_pset listed no; else lwp_pset listed yes; fi ;;
	profile)
		p := lwp_cur
		v := cp_next "$p" "$dir" "${LWP_PNAMES[@]}"
		cp_set_lwprofile "" "$v" ;;
	sb) p := lwp_cur; dt_ask "Switchboard" "HOST:PORT/KEY" "${LWP_PF[$p.switchboard]-}" lwp_setsb "the switchboard's address, then / and its key" ;;
	token) dt_ask "Token" "Token" "" lwp_settoken "the invite token your switchboard gave you; empty removes it. It is kept in a file only you can read" 1 ;;
	iface) p := lwp_cur; dt_ask "Interface" "Interface" "${LWP_PF[$p.interface]:-lw0}" lwp_setiface "for jack, the tap (lw0 to lw99, made for you); for splice, the NIC" ;;
	address) p := lwp_cur; dt_ask "Address" "Address" "${LWP_PF[$p.address]-}" lwp_setaddress "this machine's address on the line, like 10.77.0.2/24 (every machine its own, in one subnet), or dhcp to ask a DHCP server on the line; empty to leave it alone" ;;
	name) p := lwp_cur; dt_ask "Name" "Name" "${LWP_PF[$p.name]-}" lwp_setname "what callers see (a claim, not proof); empty for none" ;;
	newprofile) dt_ask "New profile" "Name" "" lwp_newprofile "letters, digits, . _ -" ;;
	renprofile) p := lwp_cur; dt_ask "Rename profile" "Name" "$p" lwp_renameprofile "the new name: letters, digits, . _ -" ;;
	rmprofile)
		p := lwp_cur
		LWP_PEND_KIND=rmprofile
		LWP_PEND_ARG=$p
		dt_confirm "Remove the profile $p? Its token goes too." lwp_yes ;;
	stopsvc)
		LWP_PEND_KIND=stopsvc
		LWP_PEND_ARG=${LWP_SOCK%/ctl}
		LWP_PEND_ARG=${LWP_PEND_ARG##*/}
		dt_confirm "Stop the site node on ${LWP_PEND_ARG}? Its calls end, and it will not start again at boot." lwp_yes ;;
	lwnode)
		DT_LW_NODE := cp_next "${LWP_SOCK:--}" "$dir" "${LWP_NODEA[@]}"
		LWP_T=-100
		cp_save ;;
	barswitch) cp_toggle DT_LWBAR; dt_has lwb_refresh && lwb_refresh ;;
	lwstyle)
		DT_LWSTYLE := cp_next "$DT_LWSTYLE" "$dir" "${LWP_STYLES[@]}"
		dt_has lwb_refresh && lwb_refresh ;;
	on) lwp_turnon "$w" ;;
	stop) dt_confirm "Turn longwire off? Calls end." lwp_yes; LWP_PEND_KIND=stop ;;
	dial) dt_ask "Dial" "Number" "" lwp_dialled "a number like 447-120-933, or +code number" ;;
	svc) dt_notep low "Control it with: systemctl status %s" "${LWP_SVC%% *}" ;;
	ring:*) lwp_ring "${k#ring:}" ;;
	rej:*) lwp_run reject "${k#rej:}"; LWP_T=-100 ;;
	hang:*) lwp_ask hangup "${k#hang:}" "Hang up on ${k#hang:}?" ;;
	evict:*) lwp_ask evict "${k#evict:}" "Evict ${k#evict:}? Every member drops it and the line key changes." ;;
	esac
	cp_save
}

fn longwire_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	policy) dt_droplist "$w" "$r" "$c" cp_set_lwpolicy "${LWP_POLICIES[@]}" ;;
	ppolicy) dt_droplist "$w" "$r" "$c" cp_set_lwppolicy "${LWP_POLICIES[@]}" ;;
	attach) dt_droplist "$w" "$r" "$c" cp_set_lwattach "${LWP_ATTACHES[@]}" ;;
	profile) dt_droplist "$w" "$r" "$c" cp_set_lwprofile "${LWP_PNAMES[@]}" ;;
	lwstyle) dt_droplist "$w" "$r" "$c" cp_set_lwstyle "${LWP_STYLES[@]}" ;;
	esac
}

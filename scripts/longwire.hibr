#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# longwire -- the node (component 2). It starts the engine through the
# module's `lw` builtin, then runs the node's brain: it reads the worker's
# events and applies the answer policy. The desktop pane (M4) reads the same
# events. See docs/CLI.md.

LW_DIR=${LW_DIR:-$HOME/.longwire}
LW_SEED=${LW_SEED:-$LW_DIR/seed}
export LW_SOCK=${LW_SOCK:-$LW_DIR/ctl}

# Load the engine module: an explicit path when one is set (the privileged
# splice service sets it), the module search otherwise.
mod load "${LONGWIRE_MOD:-longwire}" || { echo "longwire: the longwire module is not installed" >&2; exit 1; }

# lw reports failures in $ERRMSG; say them the way a command would.
run() {
	"$@" || { echo "longwire: ${ERRMSG:-failed}" >&2; exit 1; }
}

usage() {
	cat <<EOF
usage: longwire <command>

  up [--switchboard HOST:PORT/KEY] [--answer ask|known|auto|never] [--token T]
     [--splice NIC [--site-key FILE] | --jack TAP | --sock-port LOCAL:PEER] [--listen [ADDR:]PORT]
     [--peer BUNDLEFILE[@HOST:PORT]]...      run this node (foreground: a service or hold runs this)
  dial NUMBER                                 call a number
  pickup | reject                             answer the ringing call
  hangup                                      end the call
  unpin NUMBER                                forget a number's key: the next call from it is a first call again
  status                                      what the node is doing (JSON)
  down                                        stop the node
  setup splice NIC | setup jack [TAP]         print the one-time privileged step for that attach mode
  id | address | bundle                       your key id, full address (lw1...), public bundle

--answer: ask (default) rings and waits for 'longwire pickup'; known picks up numbers
you have been connected to before and asks about the rest; auto picks up anyone; never refuses.
EOF
}

# hibr holds plain stdout back when it is redirected (a service's log), so the node narrates on stderr,
# which is unbuffered: a line appears when the thing happens, in a terminal and under a service manager.
say() { echo "$@" >&2; }

# A sentence for each event, the way a person wants to read it.
announce() {
	local ev=$1
	case $ev in
	registered)       say "☎  your number ${e[number]} — dial tone" ;;
	register-refused) say "✗  the switchboard refused to register you: ${e[reason]}" ;;
	ring)             say "☎  ${e[from]} is calling"
	                  say "   safety phrase: ${e[phrase]}"
	                  [ "${e[known]}" = true ] || say "   first call from this number" ;;
	connected)        say "✓  connected to ${e[number]} (${e[path]}, ${e[ep]})"
	                  say "   safety phrase: ${e[phrase]}" ;;
	call-failed)      say "✗  call failed: ${e[reason]}" ;;
	call-lost)        say "✗  lost the call to ${e[number]}: ${e[reason]}" ;;
	site)             say "·  this box is now ${e[role]} for its LAN segment (${e[members]} on it)" ;;
	hangup)           say "·  ${e[number]} hung up (${e[by]})" ;;
	key-changed)      say "⚠  KEY CHANGED for ${e[number]}: ${e[action]}" ;;
	esac
}

# The answer policy: decide what a ring means.
on_ring() {
	local policy=$1
	case $policy in
	auto)  lw pickup > /dev/null ;;
	never) lw reject > /dev/null ;;
	known) if [ "${e[known]}" = true ]; then lw pickup > /dev/null; else say "   run: longwire pickup | longwire reject (60 s)"; fi ;;
	*)     say "   run: longwire pickup | longwire reject (60 s)" ;;
	esac
}

cmd_up() {
	local answer=ask line
	local args=()
	while [ $# -gt 0 ]; do
		case $1 in
		--answer) answer=$2; shift 2 ;;
		*) args+=("$1"); shift ;;
		esac
	done
	case $answer in ask|known|auto|never) ;; *) echo "longwire: --answer wants ask, known, auto or never" >&2; exit 2 ;; esac
	if lw status > /dev/null 2>&1; then
		say "·  a node is already running: attaching to it"	# the script restarted; the worker never stopped
	else
		run lw start --seed "$LW_SEED" --sock "$LW_SOCK" --state "$LW_DIR" "${args[@]}" > /dev/null
	fi
	trap 'lw stop > /dev/null 2>&1; exit 0' TERM INT
	exec 5</dev/longwire/events || exit 1
	# hibr runs a trap between commands, never inside a blocking read: wake once a second so TERM is prompt.
	while :; do
		read -r -t 1 -u 5 line
		rc=$?
		[ $rc -eq 142 ] && continue
		[ $rc -ne 0 ] && break
		json parse e "$line"
		case ${e[event]} in
		ring) announce ring; on_ring "$answer" ;;
		watching) ;;
		*) announce "${e[event]}" ;;
		esac
	done
}

# The one privileged step each attach mode needs, printed for you to run (or install). The node never asks for root.
cmd_setup() {
	case ${1:-} in
	splice)
		[ -n "${2:-}" ] || { echo "usage: longwire setup splice NIC" >&2; exit 2; }
		cat <<EOF
# /etc/systemd/system/longwire.service — splice $2: the one privileged step, done once
[Unit]
Description=longwire site node (splice on $2)
After=network-online.target

[Service]
User=$(id -un)
# CAP_NET_RAW opens the packet socket. 'lw start' clears every capability the moment it is open.
AmbientCapabilities=CAP_NET_RAW
# the module by absolute path, so the privileged moment never searches the environment for code
Environment=LONGWIRE_MOD=${LONGWIRE_MOD:-/usr/lib/hibr/longwire.so}
ExecStart=/usr/bin/longwire up --splice $2
Restart=always

[Install]
WantedBy=multi-user.target
EOF
		;;
	jack)
		cat <<EOF
# once, as root: a tap device you own, then the node runs as you with no privilege at all
ip tuntap add dev ${2:-lw0} mode tap user $(id -un)
ip link set ${2:-lw0} mtu 1400 up
# then: longwire up --jack ${2:-lw0} ...
EOF
		;;
	*) echo "usage: longwire setup splice NIC | setup jack [TAP]" >&2; exit 2 ;;
	esac
}

mkdir -p "$LW_DIR" && chmod 700 "$LW_DIR"

cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
up)      cmd_up "$@" ;;
dial)    [ $# -eq 1 ] || { usage >&2; exit 2; }; run lw dial "$1" ;;
pickup)  run lw pickup ;;
reject)  run lw reject ;;
hangup)  run lw hangup ;;
unpin)   [ $# -eq 1 ] || { usage >&2; exit 2; }; run lw unpin "$1" ;;
status)  run lw status ;;
down)    run lw stop ;;
setup)   cmd_setup "$@" ;;
id)      run lw key new "$LW_SEED" > /dev/null; run lw key id "$LW_SEED" ;;
address) run lw key new "$LW_SEED" > /dev/null; run lw key address "$LW_SEED" ;;
bundle)  run lw key new "$LW_SEED" > /dev/null; run lw key bundle "$LW_SEED" ;;
help|-h|--help|"") usage ;;
*)
	echo "longwire: unknown command '$cmd'" >&2
	usage >&2
	exit 2
	;;
esac

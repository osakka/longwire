#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# longwire -- the node (component 2). It starts the engine through the
# module's `lw` builtin, then runs the node's brain: it reads the worker's
# events and applies the answer policy. The desktop pane (M4) reads the same
# events. See docs/CLI.md.

# What the catalogue reads before it fetches this (docs/BUILD.md): the name, a description, the version, and the module it needs.
app longwire "One long wire between your sites: dial a number, share a LAN" 0.5.26
# modules: longwire

SELF_VERSION=${LONGWIRE_SELF_VERSION:-0.5.26}		# this script's version: the catalogue's. The engine is the package's, and a running node has its own.

LW_DIR=${LW_DIR:-$HOME/.longwire}
LW_SEED=${LW_SEED:-$LW_DIR/seed}
export LW_SOCK=${LW_SOCK:-$LW_DIR/ctl}

# Load the engine module: an explicit path when one is set (the privileged
# splice service sets it), the module search otherwise.
mod load "${LONGWIRE_MOD:-longwire}" || { echo "longwire: the longwire module is not installed" >&2; exit 1; }

# lw reports failures in $ERRMSG; say them the way a command would.
run() {
	"$@" || { echo "longwire: ${ERRMSG:-failed}" >&2; exit 1; }
}

usage() {
	cat <<EOF
usage: longwire <command>

  up [--switchboard HOST:PORT/KEY] [--answer ask|known|auto|never] [--token T] [--name TEXT] [--listed]
     [--authority OPERATORKEY | --admit ADMIT]   found a line run by an operator, or join one with the operator's admit
     [--splice NIC [--site-key FILE] | --jack TAP | --sock-port LOCAL:PEER] [--listen [ADDR:]PORT]
     [--group NAME|GID]                      let that group use the control socket (the services use: longwire)
     [--peer BUNDLEFILE[@HOST:PORT]]...      run this node (foreground: a service or hold runs this)
  dial NUMBER|lw1...                          call a number, or a full address (needs the switchboard's directory)
  pickup [ID] | reject [ID]                   answer the ringing call (ID, from the ring, if several ring)
  hangup [NUMBER]                             end every call and leave the line; or just the call with NUMBER
  peers                                       the line: its members and which of them are connected
  evict NUMBER                                remove a member from the line for good, and change its key
  who NUMBER                                  what this node knows of a number: its full address, pin, path and safety phrase
  who NAME|lw1...                             ask the switchboard's directory (if it has one) for listed nodes by name or full address
  unpin NUMBER                                forget a number's key: the next call from it is a first call again
  status                                      what the node is doing (JSON)
  answer [ask|known|auto|never]               show, or change, how the running node answers rings
  (nothing)                                   turn the node on from the default profile if it is off, then say how it is
  show                                        how the node is, in a few lines (no JSON)
  doctor                                      say whether the scripts, the installed engine and the running node are the same version
  watch                                       the node's events as sentences, as they happen (Ctrl-C leaves; the node goes on)
  down | off                                  stop the node
  on [PROFILE]                                start the node in the background, from a saved profile (the default one if none is named)
  profile list | show [NAME] | set NAME KEY=VALUE... | token NAME (on stdin) | default NAME | rename OLD NEW | remove NAME
                                              saved connections: switchboard, token, attach, interface, name, listed, answer
  jack [--address A.B.C.D/N] [--via GW [--routes NET/P,...] [--everything]] [TAP]  make the tap device a single machine attaches to (lw0 by default), with an address if asked; asks for a password once
  site NIC [PROFILE] | site --stop NIC        make this machine a site node for the card NIC from a profile (a service, after one password); or stop it
  setup splice NIC | setup jack [TAP [ADDR]]  print the one-time privileged step for that attach mode, to run by hand
  key export | import                         the identity as 33 words, and back (import reads them on stdin)
  revoke EVICTION                             carry the operator's signed eviction (hex, or a file) to the line
  operator new|authority FILE                 an operator's key: make one; show its public key
  operator admit|evict FILE LINEID NODE       sign an admit or an eviction for NODE (lw1... or key id) on that line
  id | address | bundle                       your key id, full address (lw1...), public bundle

A profile is a saved connection (~/.config/longwire/profiles, readable by you only: it holds the token). `longwire up` with no
switchboard named uses the default profile, `up --profile NAME` a named one, and anything on the command line overrides it.

--answer: ask (default) rings and waits for 'longwire pickup'; known picks up numbers
you have been connected to before and asks about the rest; auto picks up anyone; never refuses.
EOF
}

# hibr holds plain stdout back when it is redirected (a service's log), so the node narrates on stderr,
# which is unbuffered: a line appears when the thing happens, in a terminal and under a service manager.
say() { echo "$@" >&2; }

# A sentence for each event, the way a person wants to read it.
announce() {
	local ev=$1
	case $ev in
	registered)       say "☎  your number ${e[number]} — dial tone" ;;
	register-refused) say "✗  the switchboard refused to register you: ${e[reason]}" ;;
	ring)             if [ "${e[admit]}" = true ]; then say "☎  ${e[from]} is joining the line (vouched for by a member)"
	                  else
	                       if [ -n "${e[name]}" ]; then say "☎  ${e[from]} is calling, and says it is \"${e[name]}\" (a claim: only the safety phrase proves anything)"
	                       else say "☎  ${e[from]} is calling"; fi
	                       if [ -n "${e[phrase]}" ]; then say "   safety phrase: ${e[phrase]}   (the old, weaker kind: the other end is older)"
	                       else say "   the safety phrase comes once you are connected: compare it with theirs"; fi
	                       [ "${e[known]}" = true ] || say "   first call from this number"; fi ;;
	found)            [ "${e[directory]}" = true ] || say "·  this switchboard has no directory" ;;
	line-joined)      say "·  on line ${e[line]} with ${e[members]} members" ;;
	member-joined)    say "·  ${e[number]} joined the line" ;;
	member-left)      say "·  ${e[number]} left the line" ;;
	member-evicted)   say "·  ${e[number]} was evicted from the line" ;;
	evicted)          say "⚠  you were evicted from line ${e[line]}" ;;
	line-partial)     say "⚠  the line is not a full mesh: ${e[up]} of ${e[members]} members reachable (frames between the others are not forwarded)" ;;
	address-skipped)  say "⚠  not using ${e[address]}:${e[port]} to reach the other end: it is inside your jack's own network and there is no other road to it (docs/TROUBLESHOOTING.md)" ;;
	line-complete)    say "·  the line is a full mesh (${e[members]} members)" ;;
	connected)        if [ "${e[path]}" = relay ]; then say "✓  connected to ${e[number]} through a relay (${e[via]}): no direct path yet, still trying"
	                  else say "✓  connected to ${e[number]} (${e[path]}, ${e[ep]})"; fi
	                  [ "${e[path]}" != relay ] || say "   safety phrase: ${e[phrase]}   (a relayed call: the old, weaker kind)" ;;
	sas)              if [ "${e[legacy]}" = true ]; then say "   safety phrase: ${e[phrase]}   (the old, weaker kind: the other end is older). Compare it with theirs; hang up if it differs"
	                  else say "   safety phrase: ${e[phrase]}   Compare it with theirs now; hang up if it differs"; fi ;;
	sas-failed)       say "✗  the safety phrase could not be agreed with ${e[number]}: ${e[reason]}. The call was ended" ;;
	path)             say "·  ${e[number]} is now ${e[path]} (${e[ep]}): the relay is no longer needed" ;;
	call-failed)      say "✗  call failed: ${e[reason]}" ;;
	call-lost)        say "✗  lost the call to ${e[number]}: ${e[reason]}" ;;
	site)             say "·  this box is now ${e[role]} for its LAN segment (${e[members]} on it)" ;;
	hangup)           say "·  ${e[number]} hung up (${e[by]})" ;;
	dhcp-conflict)    say "⚠  two DHCP servers answer on this line (${e[servers]}): clients may get clashing leases" ;;
	key-changed)      say "⚠  KEY CHANGED for ${e[number]}: ${e[action]}" ;;
	esac
}

# The answer policy: decide what a ring means. A node vouched for by a member of our line (admit) is let in under every
# policy but `never`: that is how a mesh builds without a prompt on any member.
on_ring() {
	local policy=$1 id=${e[call]}
	[ -r "$LW_DIR/answer" ] && read -r policy < "$LW_DIR/answer"	# `longwire answer` may have changed it since `up`
	case $policy in ask|known|auto|never) ;; *) policy=ask ;; esac
	if [ "${e[admit]}" = true ] && [ "$policy" != never ]; then
		lw pickup "$id" > /dev/null
		return
	fi
	case $policy in
	auto)  lw pickup "$id" > /dev/null ;;
	never) lw reject "$id" > /dev/null ;;
	known) if [ "${e[known]}" = true ]; then lw pickup "$id" > /dev/null; else say "   run: longwire pickup | longwire reject (60 s)"; fi ;;
	*)     say "   run: longwire pickup | longwire reject (60 s)" ;;
	esac
}

# ---- profiles: saved connections -----------------------------------------------------------------------------------------------
# One file, hand-editable, rewritten whole by `longwire profile` (so a comment in it is not kept):
#
#   default home
#
#   profile home
#     switchboard = vps.example.org:1877/lw1...
#     token = 5fe1c0ab...
#     attach = jack                      jack | splice | sock (sock is for tests)
#     interface = lw0                    the tap, the NIC, or LOCAL:PEER for sock
#     name = osakka
#     listed = no
#     answer = known
LW_CONF=${LW_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/longwire}
PROFILES=$LW_CONF/profiles
declare -A PF
PNAMES=()
PDEFAULT=

profiles_read() {
	local k eq v cur=
	PF=()
	PNAMES=()
	PDEFAULT=
	[ -r "$PROFILES" ] || return 0
	while read -r k eq v; do
		case $k in
		default) PDEFAULT=$eq ;;
		profile) cur=$eq; PNAMES+=("$cur") ;;
		switchboard|token|attach|interface|address|gateway|routes|everything|keep_jack|name|listed|answer) [ -n "$cur" ] && [ "$eq" = "=" ] && PF["$cur.$k"]=$v ;;
		esac
	done < "$PROFILES"
}

profiles_write() {
	local n k out="" tmp
	[ -n "$PDEFAULT" ] && out="default $PDEFAULT
"
	for n in "${PNAMES[@]}"; do
		out="$out
profile $n
"
		for k in switchboard token attach interface address gateway routes everything keep_jack name listed answer; do
			[ -n "${PF[$n.$k]:-}" ] && out="$out  $k = ${PF[$n.$k]}
"
		done
	done
	umask 077
	mkdir -p "$LW_CONF" && chmod 700 "$LW_CONF" || { echo "longwire: cannot make $LW_CONF" >&2; exit 1; }
	tmp=$PROFILES.new
	printf '%s' "$out" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$PROFILES" || { echo "longwire: cannot write $PROFILES" >&2; exit 1; }
}

profile_exists() {
	local n
	for n in "${PNAMES[@]}"; do [ "$n" = "$1" ] && return 0; done
	return 1
}

# The arguments for `lw start` that profile $1 stands for, in PARGS; its answer policy in PANSWER.
profile_args() {
	local n=$1
	PARGS=()
	PANSWER=${PF[$n.answer]:-}
	[ -n "${PF[$n.switchboard]:-}" ] && PARGS+=(--switchboard "${PF[$n.switchboard]}")
	[ -n "${PF[$n.token]:-}" ] && PARGS+=(--token "${PF[$n.token]}")
	case ${PF[$n.attach]:-jack} in			# unset means jack, as the pane shows it
	jack)   PARGS+=(--jack "${PF[$n.interface]:-lw0}") ;;
	splice) PARGS+=(--splice "${PF[$n.interface]:-}") ;;
	sock)   PARGS+=(--sock-port "${PF[$n.interface]:-}") ;;
	esac
	[ -n "${PF[$n.name]:-}" ] && PARGS+=(--name "${PF[$n.name]}")
	[ "${PF[$n.listed]:-}" = yes ] && PARGS+=(--listed)
	[ "${PF[$n.everything]:-}" = yes ] && [ "${PF[$n.attach]:-jack}" = jack ] && PARGS+=(--everything)
	return 0
}

cmd_profile() {
	local sub=${1:-} n k v kv
	[ $# -gt 0 ] && shift
	profiles_read
	case $sub in
	list|"")
		for n in "${PNAMES[@]}"; do
			if [ "$n" = "$PDEFAULT" ]; then echo "* $n   ${PF[$n.switchboard]:-}"; else echo "  $n   ${PF[$n.switchboard]:-}"; fi
		done ;;
	show)
		n=${1:-$PDEFAULT}
		[ -n "$n" ] && profile_exists "$n" || { echo "longwire: no profile${n:+ called $n}" >&2; exit 1; }
		echo "profile $n$([ "$n" = "$PDEFAULT" ] && echo '   (default)')"
		for k in switchboard token attach interface address gateway routes everything keep_jack name listed answer; do
			v=${PF[$n.$k]:-}
			[ -n "$v" ] || continue
			[ "$k" = token ] && v="(set, ${#v} characters)"		# the token is not shown: it is in the file, readable by you only
			echo "  $k = $v"
		done ;;
	set)
		n=${1:-}
		[ $# -ge 2 ] || { echo "usage: longwire profile set NAME KEY=VALUE...   (keys: switchboard token attach interface address gateway routes everything keep_jack name listed answer)" >&2; exit 2; }
		shift
		case $n in ''|*[!A-Za-z0-9._-]*) echo "longwire: a profile name is letters, digits, . _ -" >&2; exit 2 ;; esac
		profile_exists "$n" || { PNAMES+=("$n"); [ -n "$PDEFAULT" ] || PDEFAULT=$n; }	# the first profile is the default one
		for kv in "$@"; do
			k=${kv%%=*}
			v=${kv#*=}
			[ "$k" != "$kv" ] || { echo "longwire: '$kv' is not KEY=VALUE" >&2; exit 2; }
			case $v in *[[:cntrl:]]*) echo "longwire: $k has a control character" >&2; exit 2 ;; esac
			case $k in
			switchboard|token|name|interface) ;;
			address) case $v in dhcp|"") ;; [0-9]*.[0-9]*.[0-9]*.[0-9]*/[0-9]*) case $v in *[!0-9./]*) echo "longwire: address is like 10.77.0.2/24, or dhcp" >&2; exit 2 ;; esac ;; *) echo "longwire: address is like 10.77.0.2/24, or dhcp" >&2; exit 2 ;; esac ;;
			attach) case $v in jack|splice|sock|"") ;; *) echo "longwire: attach is jack or splice" >&2; exit 2 ;; esac ;;
			gateway) case $v in ""|[0-9]*.[0-9]*.[0-9]*.[0-9]*) case $v in *[!0-9.]*) echo "longwire: gateway is an address like 192.168.152.254" >&2; exit 2 ;; esac ;; *) echo "longwire: gateway is an address like 192.168.152.254" >&2; exit 2 ;; esac ;;
			routes) case $v in *[!0-9./,]*) echo "longwire: routes are networks like 192.168.150.0/24, separated by commas" >&2; exit 2 ;; esac ;;
			keep_jack) case $v in yes|no|"") ;; *) echo "longwire: keep_jack is yes or no" >&2; exit 2 ;; esac ;;
			everything) case $v in yes|no|"") ;; *) echo "longwire: everything is yes or no" >&2; exit 2 ;; esac ;;
			listed) case $v in yes|no|"") ;; *) echo "longwire: listed is yes or no" >&2; exit 2 ;; esac ;;
			answer) case $v in ask|known|auto|never|"") ;; *) echo "longwire: answer is ask, known, auto or never" >&2; exit 2 ;; esac ;;
			*) echo "longwire: unknown key '$k' (switchboard token attach interface address gateway routes everything keep_jack name listed answer)" >&2; exit 2 ;;
			esac
			if [ -n "$v" ]; then PF["$n.$k"]=$v; else unset "PF[$n.$k]"; fi
		done
		profiles_write ;;
	token)
		# the token comes on standard input, so it is never on a command line, where any user could read it in the process list
		n=${1:-}
		profile_exists "$n" || { echo "longwire: no profile called '$n'" >&2; exit 1; }
		read -r v
		case $v in *[[:cntrl:]]*) echo "longwire: the token has a control character" >&2; exit 2 ;; esac
		if [ -n "$v" ]; then PF["$n.token"]=$v; else unset "PF[$n.token]"; fi
		profiles_write ;;
	default)
		n=${1:-}
		profile_exists "$n" || { echo "longwire: no profile called '$n'" >&2; exit 1; }
		PDEFAULT=$n
		profiles_write ;;
	rename)
		n=${1:-}
		local to=${2:-} i
		[ $# -eq 2 ] || { echo "usage: longwire profile rename OLD NEW" >&2; exit 2; }
		profile_exists "$n" || { echo "longwire: no profile called '$n'" >&2; exit 1; }
		case $to in ''|*[!A-Za-z0-9._-]*) echo "longwire: a profile name is letters, digits, . _ -" >&2; exit 2 ;; esac
		[ "$to" = "$n" ] && exit 0
		profile_exists "$to" && { echo "longwire: there is already a profile called '$to'" >&2; exit 1; }
		for i in "${!PNAMES[@]}"; do [ "${PNAMES[$i]}" = "$n" ] && PNAMES[$i]=$to; done		# same place in the list, same default
		for k in switchboard token attach interface address gateway routes everything keep_jack name listed answer; do
			if [ -n "${PF[$n.$k]:-}" ]; then PF["$to.$k"]=${PF[$n.$k]}; fi
			unset "PF[$n.$k]"
		done
		[ "$PDEFAULT" = "$n" ] && PDEFAULT=$to
		profiles_write ;;
	remove)
		n=${1:-}
		profile_exists "$n" || { echo "longwire: no profile called '$n'" >&2; exit 1; }
		local keep=() m
		for m in "${PNAMES[@]}"; do [ "$m" = "$n" ] || keep+=("$m"); done
		PNAMES=("${keep[@]}")
		for k in switchboard token attach interface address gateway routes everything keep_jack name listed answer; do unset "PF[$n.$k]"; done
		[ "$PDEFAULT" = "$n" ] && PDEFAULT=${PNAMES[0]:-}
		profiles_write ;;
	*) echo "usage: longwire profile list | show [NAME] | set NAME KEY=VALUE... | token NAME (on stdin) | default NAME | rename OLD NEW | remove NAME" >&2; exit 2 ;;
	esac
}

# Bytes and a time in the units a person reads.
human_bytes() {
	local n=$1
	if [ "$n" -ge 1000000000 ]; then echo "$((n / 1000000000)).$((n % 1000000000 / 100000000)) GB"
	elif [ "$n" -ge 1000000 ]; then echo "$((n / 1000000)).$((n % 1000000 / 100000)) MB"
	elif [ "$n" -ge 1000 ]; then echo "$((n / 1000)).$((n % 1000 / 100)) kB"
	else echo "$n B"; fi
}

human_age() {
	local s=$1
	if [ "$s" -ge 3600 ]; then echo "$((s / 3600))h$((s % 3600 / 60))m"
	elif [ "$s" -ge 60 ]; then echo "$((s / 60))m"
	else echo "${s}s"; fi
}

# How the node is, in a few lines: the number, the switchboard, who is connected and what they have carried, the line, any ring.
# Versions are a.b.c. 0 if the first is older than the second, 1 if not; an empty first one is older than anything.
ver_lt() {
	local a=$1 b=$2 a1 a2 a3 b1 b2 b3 r
	[ -n "$a" ] || return 0
	a1=${a%%.*}; r=${a#*.}; a2=${r%%.*}; a3=${r#*.}
	b1=${b%%.*}; r=${b#*.}; b2=${r%%.*}; b3=${r#*.}
	case $a1$a2$a3$b1$b2$b3 in *[!0-9]*) return 1 ;; esac
	[ $((a1 * 1000000 + a2 * 1000 + a3)) -lt $((b1 * 1000000 + b2 * 1000 + b3)) ]
}

# What is out of step, in words, one line each; nothing when all three agree. The scripts come from the catalogue and the engine from the package, and a
# running node keeps the engine it started with, so a fix can sit in one of the three and look as if it did nothing. $1 is the running node's version
# ("" if it runs but does not say: older than 0.5.10; "-" if none runs).
engine_notes() {
	local run=${1-} mod
	[ $# -ge 1 ] || run=-
	mod=$(lw version 2> /dev/null) || mod=
	if [ -z "$mod" ] || ver_lt "$mod" "$SELF_VERSION"; then
		echo "the longwire package (${mod:-older than 0.5.15}) is older than these scripts ($SELF_VERSION): please apt install --only-upgrade longwire   (the hibr repository carries it for apt, dnf and pacman)"
	elif ver_lt "$SELF_VERSION" "$mod"; then
		echo "these scripts ($SELF_VERSION) are older than the installed engine ($mod): catalogue refresh && catalogue install longwire"
	fi
	if [ "$run" != - ] && [ "$run" != "$mod" ]; then
		echo "the running node has engine ${run:-older than 0.5.10}, the installed one is ${mod:-older than 0.5.15}: longwire off, then longwire on"
	fi
}

# The running node's version as engine_notes wants it: its own, "" if it does not say, "-" if none runs.
run_version() {
	local s v
	if s=$(lw status 2> /dev/null); then
		json parse RV "$s" 2> /dev/null || { echo ""; return 0; }
		v=${RV[version]:-}
		echo "$v"
	else
		echo "-"
	fi
}

cmd_doctor() {
	local notes line
	notes=$(engine_notes "$(run_version)")
	if [ -z "$notes" ]; then
		echo "longwire: the scripts, the installed engine and the running node agree ($SELF_VERSION)"
		return 0
	fi
	printf '%s\n' "$notes" | while IFS= read -r line; do echo "⚠  $line"; done
	return 1
}

cmd_show() {
	local i cnt n num st path age rx tx t members id calls we state nm phr notes line

	if ! lw status > /dev/null 2>&1; then
		echo "longwire is off.   longwire on   turns it on"
		return 0
	fi
	json parse S "$(lw status)"
	n=${S[full]:-}
	profiles_read
	if [ -n "$n" ]; then
		echo "☎  your number $n${PDEFAULT:+    (profile $PDEFAULT)}"
	else
		echo "☎  waiting for a number from the switchboard${PDEFAULT:+    (profile $PDEFAULT)}"
	fi
	echo "   switchboard   ${S[switchboard]:-?}${S[nat]:+     NAT ${S[nat]}}"
	echo "   engine        ${S[version]:-unknown (older than 0.5.10)}"
	notes=$(engine_notes "${S[version]:-}")
	[ -z "$notes" ] || printf '%s\n' "$notes" | while IFS= read -r line; do echo "   ⚠  $line"; done
	if [ -n "${S[tied]:-}" ]; then		# everything through the line (docs/adr/0045)
		local erule
		erule=$(PATH=$PATH:/usr/sbin:/sbin ip -4 route get 1.1.1.1 2> /dev/null)
		if [[ $erule =~ \ dev\ (lw[0-9]+) ]]; then
			echo "   everything    through the line (${M[1]}); the line itself goes by ${S[tied]}"
		else
			echo "   everything    asked, but this machine's traffic is not going through the line: longwire off, then on, puts it back (docs/adr/0045)"
		fi
	elif [ "${S[jack_nets]:-0}" -gt 0 ]; then
		case ${S[underlay_state]:-} in
		open)   echo "   underlay      ${S[underlay]} (your jack has an address; traffic to peers in its network leaves by this device)" ;;
		failed) echo "   underlay      none could be had: peers in your jack's own network are not reachable (docs/adr/0037)" ;;
		*)      echo "   underlay      not needed yet (your jack has an address)" ;;
		esac
	fi
	cnt := json len S .peers
	for ((i = 0; i < ${cnt:-0}; i++)); do
		num := json get S ".peers[$i].number"
		st := json get S ".peers[$i].state"
		path := json get S ".peers[$i].path"
		age := json get S ".peers[$i].age"
		rx := json get S ".peers[$i].rx_bytes"
		tx := json get S ".peers[$i].tx_bytes"
		[ -n "$num" ] || continue
		echo "   connected     $num  $st${path:+ $path}${age:+, $(human_age "${age%.*}")}  in $(human_bytes "${rx:-0}"), out $(human_bytes "${tx:-0}")"
		phr := json get S ".peers[$i].phrase"
		[ -z "$phr" ] || echo "                 safety phrase: $phr"
	done
	t := json get S .cand_skipped
	[ "${t:-0}" -gt 0 ] && echo "   ⚠  ${t} address(es) of the other end are inside your jack's own network and could not be reached another way, so they are not used (longwire watch names them)"
	t := json type S .line
	if [ "$t" = object ]; then
		id := json get S .line.id
		members := json len S .line.members
		echo "   line          $members members (line ${id:-?})"
	fi
	calls := json len S .calls
	for ((i = 0; i < ${calls:-0}; i++)); do
		state := json get S ".calls[$i].state"
		we := json get S ".calls[$i].we_called"
		if [ "$state" = ringing ] && [ "$we" != true ]; then
			num := json get S ".calls[$i].number"
			nm := json get S ".calls[$i].name"
			phr := json get S ".calls[$i].phrase"
			echo "   RINGING       $num${nm:+ (\"$nm\", a claim)}   ${phr:+safety phrase: $phr}${phr:-the safety phrase comes once you are connected}   -> longwire pickup | longwire reject"
		fi
	done
}

# `longwire` with nothing said: if there is a connection to turn on and the node is off, turn it on; then say how it is. With no
# connection yet it says how to make one, and that the Control Panel does the same.
cmd_here() {
	profiles_read
	if ! lw status > /dev/null 2>&1; then
		if [ -z "$PDEFAULT" ]; then
			cat <<EOM
longwire is off, and there is no connection saved yet. Either open Control Panel > Longwire and fill in the form, or:

  longwire profile set home switchboard=HOST:PORT/KEY token=... attach=jack interface=lw0
  longwire                     # turns it on, in the background

(longwire help lists everything)
EOM
			return 0
		fi
		cmd_on "$PDEFAULT" || return 1
	fi
	cmd_show
}

# The next event line from fd 5, waiting at most a second (hibr runs a trap only between commands, so a blocking read would hold TERM). `read -t` is a
# deadline for the whole read: a line that starts just before it is cut, and what was taken is kept in EVPART and joined by the rest on the next call, so no
# event is lost or torn in two. Returns 142 when there is no whole line yet, the line in EVLINE.
EVPART=
EVLINE=
next_event() {
	local more rc
	read -r -t 1 -u 5 more
	rc=$?
	if [ $rc -eq 142 ]; then
		EVPART=$EVPART$more
		return 142
	fi
	[ $rc -ne 0 ] && return $rc
	EVLINE=$EVPART$more
	EVPART=
	return 0
}

# The node's events as sentences, as they happen. It only listens: Ctrl-C leaves and the node goes on.
cmd_watch() {
	local rc line
	lw status > /dev/null 2>&1 || { echo "longwire: it is off.  longwire on" >&2; exit 1; }
	trap 'exit 0' TERM INT
	exec 5</dev/longwire/events || exit 1
	say "·  watching (Ctrl-C leaves; the node goes on)"
	while :; do
		next_event
		rc=$?
		[ $rc -eq 142 ] && continue
		[ $rc -ne 0 ] && break
		line=$EVLINE
		if ! json parse e "$line" 2> /dev/null; then			# say what came, so that a bad one can be looked at
			say "·  an event could not be read: ${line:0:300}"
			continue
		fi
		case ${e[event]} in
		watching) ;;
		ring) announce ring; [ "${e[admit]}" = true ] || say "   run: longwire pickup | longwire reject" ;;
		*) announce "${e[event]}" ;;
		esac
	done
	say "·  the node stopped"
}

# The jack: a tap device owned by the person, made by a small root helper (packaging/longwire-jack) that polkit lets the desktop's
# user run after one password. A person never types `ip tuntap` for it; setup jack prints that for those who want to do it by hand.
jack_helper() {
	local f
	for f in "${LONGWIRE_JACK:-}" /usr/lib/longwire/jack /usr/local/lib/longwire/jack; do
		[ -n "$f" ] && [ -x "$f" ] && { echo "$f"; return 0; }
	done
	return 1
}

# Is the address (A.B.C.D/N) on the device already? Asked without privilege, so that a password is only needed when it is not. For "dhcp": a client of ours
# is running on it, or it already has an IPv4 address.
jack_has_addr() {
	if [ "$2" = dhcp ]; then
		local pid
		read -r pid < "${LONGWIRE_RUN:-/run/longwire}/dhcp-$1.pid" 2> /dev/null
		[ -n "${pid:-}" ] && [ -d "/proc/$pid" ] && return 0
		PATH=$PATH:/usr/sbin:/sbin ip -4 -o addr show dev "$1" 2> /dev/null | grep -q ' inet '
		return
	fi
	PATH=$PATH:/usr/sbin:/sbin ip -4 -o addr show dev "$1" 2> /dev/null | grep -q " ${2%/*}/"
}

# Are the routes (NET/PREFIX,... via GATEWAY) on the jack already? Asked without privilege, so that a password is only needed when one is missing.
jack_has_routes() {
	local tap=$1 via=$2 routes=$3 have r
	local rl=()
	[ -n "$routes" ] && [ -n "$via" ] || return 0
	have=$(PATH=$PATH:/usr/sbin:/sbin ip -4 route show dev "$tap" 2> /dev/null)
	read -r -a rl <<< "${routes//,/ }"
	for r in "${rl[@]}"; do
		printf '%s\n' "$have" | grep -q "^$r via $via\( \|$\)" || return 1
	done
	return 0
}

# Is everything going through the line as asked (yes or no) for this jack: its own table holding the default route through the gateway, behind the two rules
# (docs/adr/0045)? Asked without privilege too.
jack_has_everything() {
	local tap=$1 via=$2 want=$3 table rule
	[[ $tap =~ ^lw[0-9]{1,2}$ ]] || return 0		# only lw0 to lw99 is ever a jack with a table
	table=$(( 7700 + ${tap#lw} ))
	rule=$(PATH=$PATH:/usr/sbin:/sbin ip -4 rule show pref 7701 2> /dev/null)
	if [ "$want" != yes ]; then
		printf '%s\n' "$rule" | grep -qw "lookup $table" && return 1
		return 0
	fi
	printf '%s\n' "$rule" | grep -qw "lookup $table" || return 1
	PATH=$PATH:/usr/sbin:/sbin ip -4 rule show pref 7700 2> /dev/null | grep -q "suppress_prefixlength 0" || return 1
	PATH=$PATH:/usr/sbin:/sbin ip -4 route show table "$table" 2> /dev/null | grep -q "^default via $via dev $tap\( \|$\)" || return 1
	return 0
}

cmd_jack() {
	local addr= tap helper mode=
	if [ "${1:-}" = --remove ]; then
		shift
		tap=${1:-lw0}
		[ -d "/sys/class/net/$tap" ] || { echo "longwire: the jack $tap is not there"; return 0; }
		helper=$(jack_helper) || { echo "longwire: the jack helper is not installed. By hand, as root: ip link delete $tap" >&2; return 1; }
		if [ "$(id -u)" = 0 ]; then
			"$helper" --remove "$tap" "${SUDO_UID:-}"
		elif command -v pkexec > /dev/null; then
			pkexec "$helper" --remove "$tap"
		else
			echo "longwire: there is no pkexec to ask for the password with. By hand, as root: ip link delete $tap" >&2
			return 1
		fi
		return
	fi
	local via= routes= r all=no
	local extra=()
	while [ $# -gt 0 ]; do
		case $1 in
		--everything) all=yes; shift; continue ;;
		--address|--via|--routes)
			[ $# -ge 2 ] || { echo "usage: longwire jack [--address A.B.C.D/N | dhcp] [--via GATEWAY [--routes NET/PREFIX,...] [--everything]] [TAP]" >&2; exit 2; }
			case $1 in --address) addr=$2 ;; --via) via=$2 ;; --routes) routes=$2 ;; esac
			shift 2 ;;
		*) break ;;
		esac
	done
	[ "$addr" = dhcp ] && mode=--dhcp
	tap=${1:-lw0}
	[ -n "$routes" ] || [ $all = yes ] || via=		# a gateway with nothing to be the gateway for is not passed on
	[ -z "$via" ] || extra=(--via "$via")
	[ -z "$routes" ] || [ -z "$via" ] || extra+=(--routes "$routes")
	[ $all = no ] || extra+=(--everything)
	if [ $all = yes ] && [ -z "$via" ]; then
		echo "longwire: everything through the line needs a gateway on it: longwire profile set NAME gateway=A.B.C.D" >&2
		return 1
	fi
	if [ -d "/sys/class/net/$tap" ] && { [ -z "$addr" ] || jack_has_addr "$tap" "$addr"; } && jack_has_routes "$tap" "$via" "$routes" && jack_has_everything "$tap" "$via" $all; then
		if [ "$addr" = dhcp ]; then
			echo "longwire: the jack $tap is there, with DHCP"
		else
			echo "longwire: the jack $tap is there${addr:+, with $addr}${routes:+, and routes to $routes via $via}$([ $all = yes ] && echo ", and everything goes through $via")"
		fi
		return 0
	fi
	if ! helper=$(jack_helper); then
		echo "longwire: the jack helper is not installed (the longwire package has it). By hand, once, as root:" >&2
		cmd_setup jack "$tap" ${addr:+"$addr"} >&2
		if [ -n "$routes" ]; then
			local rl=()
			read -r -a rl <<< "${routes//,/ }"
			for r in "${rl[@]}"; do echo "ip route add $r via $via dev $tap" >&2; done
		fi
		return 1
	fi
	if [ "$(id -u)" = 0 ]; then
		"$helper" ${mode:-${addr:+--address "$addr"}} "${extra[@]}" "$tap" "${SUDO_UID:-}"
	elif command -v pkexec > /dev/null; then
		pkexec "$helper" ${mode:-${addr:+--address "$addr"}} "${extra[@]}" "$tap"
	else
		echo "longwire: there is no pkexec to ask for the password with. By hand, once, as root:" >&2
		cmd_setup jack "$tap" ${addr:+"$addr"} >&2
		return 1
	fi
}

# A site node on this machine: a service (longwire@NIC) that splices the card NIC, made by a root helper (packaging/longwire-site) that polkit lets the desktop's user
# run after one password. The options go to the helper in a file only the user can read (the token stays out of the process list); the helper checks them word by word.
site_helper() {
	local f
	for f in "${LONGWIRE_SITE:-}" /usr/lib/longwire/site /usr/local/lib/longwire/site; do
		[ -n "$f" ] && [ -x "$f" ] && { echo "$f"; return 0; }
	done
	return 1
}

cmd_site() {
	local helper nic profile argsf line uid
	if ! helper=$(site_helper); then
		echo "longwire: the site helper is not installed (the longwire package has it). By hand: longwire setup splice NIC" >&2
		return 1
	fi
	if ! command -v pkexec > /dev/null && [ "$(id -u)" != 0 ]; then
		echo "longwire: there is no pkexec to ask for the password with. By hand: longwire setup splice NIC" >&2
		return 1
	fi
	if [ "${1:-}" = --stop ]; then
		nic=${2:-}
		[ -n "$nic" ] || { echo "usage: longwire site --stop NIC" >&2; exit 2; }
		if [ "$(id -u)" = 0 ]; then "$helper" --stop "$nic"; else pkexec "$helper" --stop "$nic"; fi
		return
	fi
	nic=${1:-}
	[ -n "$nic" ] || { echo "usage: longwire site NIC [PROFILE]  |  longwire site --stop NIC" >&2; exit 2; }
	profiles_read
	profile=${2:-$PDEFAULT}
	[ -n "$profile" ] && profile_exists "$profile" || { echo "longwire: no profile${profile:+ called $profile}  (longwire profile list)" >&2; exit 1; }
	[ -n "${PF[$profile.switchboard]:-}" ] || { echo "longwire: profile $profile has no switchboard" >&2; exit 1; }
	line="--switchboard ${PF[$profile.switchboard]}"
	[ -z "${PF[$profile.token]:-}" ] || line="$line --token ${PF[$profile.token]}"
	case ${PF[$profile.name]:-} in
	'') ;;
	*[!A-Za-z0-9._-]*) echo "longwire: the name '${PF[$profile.name]}' has a space or a mark a service cannot carry: the site node goes without it" >&2 ;;
	*) line="$line --name ${PF[$profile.name]}" ;;
	esac
	[ -z "${PF[$profile.answer]:-}" ] || line="$line --answer ${PF[$profile.answer]}"
	[ "${PF[$profile.listed]:-}" != yes ] || line="$line --listed"
	umask 077
	mkdir -p "$LW_DIR" && chmod 700 "$LW_DIR"
	argsf=$LW_DIR/site-args
	printf '%s\n' "$line" > "$argsf" && chmod 600 "$argsf" || { echo "longwire: cannot write $argsf" >&2; return 1; }
	if [ "$(id -u)" = 0 ]; then
		"$helper" "$nic" "$argsf" "${SUDO_UID:-}"
	else
		pkexec "$helper" "$nic" "$argsf"
	fi
	uid=$?
	rm -f "$argsf"
	return $uid
}

# Stop the node; and, for a profile that says keep_jack=no, take the jack away too (one more password, unless it was given a moment ago).
cmd_off() {
	local p i tap
	run lw stop
	profiles_read
	p=$PDEFAULT
	[ -n "$p" ] && profile_exists "$p" || return 0
	[ "${PF[$p.keep_jack]:-yes}" = no ] && [ "${PF[$p.attach]:-jack}" = jack ] || return 0
	tap=${PF[$p.interface]:-lw0}
	for ((i = 0; i < 30; i++)); do			# up to 3 s for the worker to let go
		lw status > /dev/null 2>&1 || break
		sleep 0.1
	done
	cmd_jack --remove "$tap"
}

# Start the node in the background and say how it went: the number it was given, or why not.
cmd_on() {
	local n=${1:-} i notes line
	if lw status > /dev/null 2>&1; then
		json parse S "$(lw status)"
		echo "longwire: already on${S[number]:+: your number is ${S[number]}}"
		notes=$(engine_notes "${S[version]:-}")
		[ -z "$notes" ] || printf '%s\n' "$notes" | while IFS= read -r line; do echo "longwire: ⚠  $line" >&2; done
		return 0
	fi
	notes=$(engine_notes -)
	[ -z "$notes" ] || printf '%s\n' "$notes" | while IFS= read -r line; do echo "longwire: ⚠  $line" >&2; done
	profiles_read
	[ -n "$n" ] || n=$PDEFAULT
	if [ -z "$n" ]; then
		echo "longwire: no profile yet. Make one:  longwire profile set home switchboard=HOST:PORT/KEY token=... attach=jack interface=lw0" >&2
		exit 2
	fi
	profile_exists "$n" || { echo "longwire: no profile called '$n'  (longwire profile list)" >&2; exit 1; }
	if [ "${PF[$n.attach]:-jack}" = jack ]; then
		local ev=()
		[ "${PF[$n.everything]:-}" = yes ] && ev=(--everything)
		cmd_jack ${PF[$n.address]:+--address "${PF[$n.address]}"} ${PF[$n.gateway]:+--via "${PF[$n.gateway]}"} ${PF[$n.routes]:+--routes "${PF[$n.routes]}"} "${ev[@]}" "${PF[$n.interface]:-lw0}" || exit 1			# made now, with a password if it must be
	fi
	: > "$LW_DIR/log"
	nohup setsid "${LONGWIRE_HIBR:-hibr}" "$0" up --profile "$n" >> "$LW_DIR/log" 2>&1 < /dev/null &
	for ((i = 0; i < 150; i++)); do			# up to 15 s for the switchboard to give a number
		if lw status > /dev/null 2>&1; then
			json parse S "$(lw status)"
			if [ -n "${S[number]:-}" ]; then echo "longwire: on, your number is ${S[number]}   (profile $n)"; return 0; fi
		fi
		sleep 0.1
	done
	if lw status > /dev/null 2>&1; then
		if grep -q '^✗' "$LW_DIR/log" 2> /dev/null; then		# the switchboard said no: that is a failure, and the log says why
			echo "longwire: on (profile $n), but the switchboard has not given a number:" >&2
			tail -n 5 "$LW_DIR/log" >&2
			return 1
		fi
		echo "longwire: on (profile $n), waiting for the switchboard to give a number (longwire show says when it has)"	# slow or unreachable: not a failure to start
		tail -n 3 "$LW_DIR/log" >&2
		return 0
	fi
	echo "longwire: it did not start:" >&2
	tail -n 5 "$LW_DIR/log" >&2
	return 1
}

cmd_up() {
	local answer= line profile= given=0 a
	local args=()
	while [ $# -gt 0 ]; do
		case $1 in
		--profile) [ $# -ge 2 ] || { echo "longwire: --profile needs a name" >&2; exit 2; }; profile=$2; shift 2; continue ;;
		--switchboard|--jack|--splice|--sock-port|--peer) given=1 ;;&
		--answer|--admit) [ $# -ge 2 ] || { echo "longwire: $1 needs a value" >&2; exit 2; } ;;&
		--answer) answer=$2; shift 2 ;;
		--admit) local ad=$2; [ -r "$ad" ] && read -r ad < "$2"; args+=(--admit "$ad"); shift 2 ;;	# a file, or the hex itself
		*) args+=("$1"); shift ;;
		esac
	done
	if [ -z "$profile" ] && [ $given -eq 0 ]; then			# nothing named: the default profile is the connection
		profiles_read
		profile=$PDEFAULT
	fi
	if [ -n "$profile" ]; then
		profiles_read
		profile_exists "$profile" || { echo "longwire: no profile called '$profile'  (longwire profile list)" >&2; exit 1; }
		profile_args "$profile"
		args=("${PARGS[@]}" "${args[@]}")			# the profile first: what is said on the command line comes after it and wins
		[ -n "$answer" ] || answer=$PANSWER
		say "·  profile $profile"
	fi
	local k jk= ev=0
	for ((k = 0; k < ${#args[@]}; k++)); do			# a jack whose table takes everything: the node must keep its own traffic off it, whoever started it (docs/adr/0045)
		[ "${args[$k]}" = --jack ] && [ $((k + 1)) -lt ${#args[@]} ] && jk=${args[$((k + 1))]}
		[ "${args[$k]}" = --everything ] && ev=1
	done
	if [ $ev = 0 ] && [[ $jk =~ ^lw[0-9]{1,2}$ ]] && PATH=$PATH:/usr/sbin:/sbin ip -4 rule show pref 7701 2> /dev/null | grep -qw "lookup $(( 7700 + ${jk#lw} ))"; then
		args+=(--everything)
		say "·  everything goes through $jk: the node keeps its own traffic off it"
	fi
	[ -n "$answer" ] || answer=ask
	case $answer in ask|known|auto|never) ;; *) echo "longwire: --answer wants ask, known, auto or never" >&2; exit 2 ;; esac
	echo "$answer" > "$LW_DIR/answer"
	if lw status > /dev/null 2>&1; then
		say "·  a node is already running: attaching to it"	# the script restarted; the worker never stopped
	else
		run lw start --seed "$LW_SEED" --sock "$LW_SOCK" --state "$LW_DIR" "${args[@]}" > /dev/null
	fi
	trap 'lw stop > /dev/null 2>&1; exit 0' TERM INT
	exec 5</dev/longwire/events || exit 1
	# hibr runs a trap between commands, never inside a blocking read: wake once a second so TERM is prompt.
	while :; do
		next_event
		rc=$?
		[ $rc -eq 142 ] && continue
		[ $rc -ne 0 ] && break
		line=$EVLINE
		json parse e "$line"
		case ${e[event]} in
		ring) announce ring; on_ring "$answer" ;;
		watching) ;;
		*) announce "${e[event]}" ;;
		esac
	done
}

# Ask the switchboard's directory for a name or a full address, and print its answer (JSON). The answer arrives as an
# event, so listen first and ask second.
cmd_find() {
	local i rc line
	exec 5</dev/longwire/events || exit 1
	run lw lookup "$1" > /dev/null
	for i in 1 2 3 4 5 6 7 8; do
		next_event
		rc=$?
		[ $rc -eq 142 ] && continue
		[ $rc -ne 0 ] && break
		line=$EVLINE
		json parse e "$line"
		[ "${e[event]}" = found ] && { echo "$line"; return 0; }
	done
	echo "longwire: the directory did not answer" >&2
	exit 1
}

# The one privileged step each attach mode needs, printed for you to run (or install). The node never asks for root.
cmd_setup() {
	case ${1:-} in
	splice)
		[ -n "${2:-}" ] || { echo "usage: longwire setup splice NIC" >&2; exit 2; }
		cat <<EOF
# /etc/systemd/system/longwire.service — splice $2: the one privileged step, done once
[Unit]
Description=longwire site node (splice on $2)
After=network-online.target

[Service]
User=$(id -un)
# CAP_NET_RAW opens the packet socket. 'lw start' clears every capability the moment it is open.
AmbientCapabilities=CAP_NET_RAW
# the module by absolute path, so the privileged moment never searches the environment for code
Environment=LONGWIRE_MOD=${LONGWIRE_MOD:-/usr/lib/hibr/longwire.so}
ExecStart=/usr/bin/longwire up --splice $2
Restart=always

[Install]
WantedBy=multi-user.target
EOF
		;;
	jack)
		cat <<EOF
# once, as root: a tap device you own, then the node runs as you with no privilege at all
ip tuntap add dev ${2:-lw0} mode tap user $(id -un)
ip link set ${2:-lw0} mtu 1400 up${3:+$([ "$3" = dhcp ] && echo "
dhclient -nw ${2:-lw0}      # (or dhcpcd -b -G ${2:-lw0}, or udhcpc -b -i ${2:-lw0}: not the default route or the name servers of a line)" || echo "
ip addr add $3 dev ${2:-lw0}")}
# then: longwire up --jack ${2:-lw0} ...
EOF
		;;
	*) echo "usage: longwire setup splice NIC | setup jack [TAP [ADDR]]" >&2; exit 2 ;;
	esac
}

mkdir -p "$LW_DIR" && chmod 700 "$LW_DIR"

cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
up)      cmd_up "$@" ;;
dial)    [ $# -eq 1 ] || { usage >&2; exit 2; }; run lw dial "$1" ;;
pickup)  run lw pickup "$@" ;;
reject)  run lw reject "$@" ;;
hangup)  run lw hangup "$@" ;;
evict)   [ $# -eq 1 ] || { usage >&2; exit 2; }; run lw evict "$1" ;;
peers)   run lw peers ;;
who)     [ $# -eq 1 ] || { usage >&2; exit 2; }
         case $1 in
         [0-9][0-9][0-9]-[0-9][0-9][0-9]-[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]|+[0-9]*) run lw who "$1" ;;
         *) cmd_find "$1" ;;
         esac ;;
unpin)   [ $# -eq 1 ] || { usage >&2; exit 2; }; run lw unpin "$1" ;;
status)  run lw status ;;
answer)  case "${1:-}" in
         "") if [ -r "$LW_DIR/answer" ]; then cat "$LW_DIR/answer"; else echo ask; fi ;;
         ask|known|auto|never) [ $# -eq 1 ] || { usage >&2; exit 2; }; echo "$1" > "$LW_DIR/answer" ;;
         *) echo "longwire: answer wants ask, known, auto or never" >&2; exit 2 ;;
         esac ;;
down)    cmd_off ;;
off)     cmd_off ;;
on)      cmd_on "$@" ;;
jack)    cmd_jack "$@" ;;
profile) cmd_profile "$@" ;;
setup)   cmd_setup "$@" ;;
id)      run lw key new "$LW_SEED" > /dev/null; run lw key id "$LW_SEED" ;;
address) run lw key new "$LW_SEED" > /dev/null; run lw key address "$LW_SEED" ;;
key)
	case "${1:-}" in
	export) [ -r "$LW_SEED" ] || { echo "longwire: no identity yet" >&2; exit 1; }; run lw key export "$LW_SEED" ;;
	import) run lw key import "$LW_SEED" > /dev/null; say "identity restored: your number comes back when you ring the switchboard" ;;
	*) echo "usage: longwire key export | import   (import reads the words on standard input)" >&2; exit 2 ;;
	esac ;;
revoke)  [ $# -eq 1 ] || { usage >&2; exit 2; }; ev=$1; [ -r "$ev" ] && read -r ev < "$1"; run lw revoke "$ev" ;;
operator)
	op=${2:-}
	case "${1:-}" in
	new)       [ $# -eq 2 ] || { usage >&2; exit 2; }; run lw key new "$op" > /dev/null; run lw key authority "$op" ;;
	authority) [ $# -eq 2 ] || { usage >&2; exit 2; }; run lw key authority "$op" ;;
	admit|evict) [ $# -eq 4 ] || { usage >&2; exit 2; }; run lw key "$1" "$op" "$3" "$4" ;;
	*) usage >&2; exit 2 ;;
	esac ;;
bundle)  run lw key new "$LW_SEED" > /dev/null; run lw key bundle "$LW_SEED" ;;
"")      cmd_here ;;
show)    cmd_show ;;
site)    cmd_site "$@" ;;
doctor)  cmd_doctor ;;
watch)   cmd_watch ;;
help|-h|--help) usage ;;
*)
	echo "longwire: unknown command '$cmd'" >&2
	usage >&2
	exit 2
	;;
esac

#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# longwire-switchboard -- the switchboard (component 1). The module's C worker
# runs the mechanism (sessions, presence, introductions); this script is the
# policy: who may register, and whose call may ring. See docs/SWITCHBOARD.md.
#
#   longwire-switchboard [--listen ADDR:PORT] [--tokens FILE] [--state DIR]
#                        [--per-ip-hour N] [--rings-per-minute N] [--max-nodes N]
#                        [--caller-id on|off] [--directory on|off]
#                        [--release-after TIME]
#                        --registry HOST:PORT/KEY|none [--issue-codes [--public-switchboard KEY]] [--codes-per-ip-day N]
#
# --tokens FILE   registration needs a token: one per line, "TOKEN" or
#                 "TOKEN NUMBER" (that token claims that number). A token is
#                 spent when it is used. Without it, registration is open.
# --caller-id off / --directory off   do not carry names on rings / do not answer lookups (both on by default;
#                 a node only appears in either if it asked to).
# --registry      the registry of switchboard codes, which gives this switchboard its short code (+1, +20, ...); "none"
#                 for a private switchboard, which keeps its derived code (+0...). Required.
# --release-after TIME   a number unheard for that long is released, then held back for as long again (default 365d;
#                 days, or a suffix s, m, h or d). Its owner coming back in that time gets the same number.
# --issue-codes   this switchboard IS a registry: it gives codes to switchboards that register with it
#                 (--public-switchboard KEY names the one that gets +1; --codes-per-ip-day limits askers, default 2).

# What the catalogue reads before it fetches this (docs/BUILD.md): the name, a description, the version, and the module it needs.
app longwire-switchboard "The longwire switchboard: introduces two nodes, then steps aside" 0.3.1
# modules: longwire

SB_DIR=${SB_DIR:-$HOME/.longwire/switchboard}
listen=1877
tokens=
per_ip_hour=20
rings_per_min=6
max_nodes=1024
caller_id=on
directory=on
registry=
issue_codes=
public_sb=
codes_per_ip_day=2
release_after=365d

mod load "${LONGWIRE_MOD:-longwire}" || { echo "longwire-switchboard: the longwire module is not installed" >&2; exit 1; }

while [ $# -gt 0 ]; do
	case $1 in
	--listen) listen=$2 ;;
	--tokens) tokens=$2 ;;
	--state) SB_DIR=$2 ;;
	--per-ip-hour) per_ip_hour=$2 ;;
	--rings-per-minute) rings_per_min=$2 ;;
	--max-nodes) max_nodes=$2 ;;
	--registry) registry=$2 ;;
	--issue-codes) issue_codes=1; shift; continue ;;
	--public-switchboard) public_sb=$2 ;;
	--codes-per-ip-day) codes_per_ip_day=$2 ;;
	--release-after) release_after=$2 ;;
	--caller-id) caller_id=$2 ;;
	--directory) directory=$2 ;;
	-h|--help) sed -n '4,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	*) echo "longwire-switchboard: unknown option $1" >&2; exit 2 ;;
	esac
	shift 2 2>/dev/null || shift
done

if [ -z "$registry" ]; then
	echo "longwire-switchboard: --registry HOST:PORT/KEY is needed: the registry gives this switchboard its short code." >&2
	echo "                      A private switchboard that wants none says --registry none and keeps its derived code." >&2
	exit 2
fi
export LW_SOCK=${LW_SOCK:-$SB_DIR/ctl}		# after the options: --state moves the socket too
mkdir -p "$SB_DIR" && chmod 700 "$SB_DIR"
declare -A seen    # counters, keyed by what they count and the hour or minute

# Take a token out of the file: prints the reserved number, if it has one.
# Fails when the token isn't there.
spend_token() {
	local want=$1 tok num found=1 out=
	while read -r tok num; do
		[ -n "$tok" ] || continue
		if [ "$tok" = "$want" ] && [ $found -ne 0 ]; then
			found=0
			[ -n "$num" ] && echo "$num"
		else
			out="$out$tok${num:+ $num}
"
		fi
	done < "$tokens"
	[ $found -eq 0 ] && printf '%s' "$out" > "$tokens"
	return $found
}

on_register() {
	local now=$(date +%s) k n num
	if [ "${e[switchboard]}" = true ]; then		# a switchboard asking this registry for its code: codes are scarce
		k="code:${e[ip]%:*}:$((now / 86400))"
		n=$(( ${seen[$k]:-0} + 1 )); seen[$k]=$n
		if [ $n -gt $codes_per_ip_day ]; then
			lw sb reply "${e[id]}" refuse "too many codes asked for from this address today" > /dev/null
		else
			lw sb reply "${e[id]}" accept > /dev/null
		fi
		return
	fi
	k="reg:${e[ip]%:*}:$((now / 3600))"
	n=$(( ${seen[$k]:-0} + 1 )); seen[$k]=$n
	if [ $n -gt $per_ip_hour ]; then
		lw sb reply "${e[id]}" refuse "too many registrations from this address" > /dev/null; return
	fi
	if [ -n "$tokens" ]; then
		if num=$(spend_token "${e[token]}"); then
			lw sb reply "${e[id]}" accept $num > /dev/null
		else
			lw sb reply "${e[id]}" refuse "a valid token is needed to register here" > /dev/null
		fi
		return
	fi
	lw sb reply "${e[id]}" accept > /dev/null
}

on_dial() {
	local now=$(date +%s) k n
	k="ring:${e[to]}:$((now / 60))"
	n=$(( ${seen[$k]:-0} + 1 )); seen[$k]=$n
	if [ $n -gt $rings_per_min ]; then
		lw sb reply "${e[id]}" refuse > /dev/null
	else
		lw sb reply "${e[id]}" accept > /dev/null
	fi
}

run() { "$@" || { echo "longwire-switchboard: ${ERRMSG:-failed}" >&2; exit 1; }; }

case "$release_after" in
*s) release_secs=${release_after%s} ;;
*m) release_secs=$(( ${release_after%m} * 60 )) ;;
*h) release_secs=$(( ${release_after%h} * 3600 )) ;;
*d) release_secs=$(( ${release_after%d} * 86400 )) ;;
*[!0-9]*) echo "longwire-switchboard: --release-after wants a time like 365d, 12h or 90s" >&2; exit 2 ;;
*) release_secs=$(( release_after * 86400 )) ;;
esac

run lw key new "$SB_DIR/seed" > /dev/null
run lw sb start --seed "$SB_DIR/seed" --sock "$LW_SOCK" --state "$SB_DIR" --listen "$listen" --policy script --maxpeers "$max_nodes" --caller-id "$caller_id" --directory "$directory" --registry "$registry" --release-after "$release_secs" ${issue_codes:+--issue-codes} ${public_sb:+--public-switchboard "$public_sb"} > /dev/null
addr=$(lw key address "$SB_DIR/seed")
echo "switchboard  $addr   (give this full address to your nodes)"
echo "listening    udp $listen    tokens: ${tokens:-open registration}"
trap 'lw stop > /dev/null 2>&1; exit 0' TERM INT

exec 5</dev/longwire/events || exit 1
while read -r -u 5 line; do
	json parse e "$line"
	case ${e[event]} in
	register) on_register ;;
	dial) on_dial ;;
	esac
done

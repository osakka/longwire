#!/usr/bin/env hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# switchboard -- a window on a longwire switchboard you run: how many nodes are on it, which of them are online, and who
# is ringing whom right now. It reads the switchboard's own worker through `lw`, once a second, and follows its event
# stream for the calls. It watches; it does not decide anything (a ring and a registration are the script's to answer,
# and the script has two seconds). It shows no address and no key: the worker does not give the registry any.
#
# Traffic in and out, the calls since it started, and the bans are on its head; `/` searches the nodes by number or name, `o` shows only
# those online, `b` turns the list into the bans (and `x` lifts one, for the switchboard's owner). Every key is in the menus (docs/adr/0049).
#
# A call is shown while it is being set up and for a few seconds after, and then it is gone. Nothing here is written
# to disk, and the window keeps no list of past calls: that is what the switchboard promises (docs/SWITCHBOARD.md).
#
# It reads the worker of the user who runs the desktop or, if there is none, a switchboard that runs as a service under another
# user, which the group longwire lets you reach (docs/adr/0032-the-services-share-their-control-socket-with-a-group.md). If it
# can reach neither, the window says so and how to join the group, instead of showing an empty board.

strict

app switchboard "Watch a longwire switchboard: who is on it and who is ringing whom" 0.5.49
# modules: longwire
command -v dt_app > /dev/null && dt_app switchboard "Switchboard" 24 76 once "☎"

declare -gA SW SWN SWF SWB
declare -gA SWT
declare -g SW_LIFT= SW_LIFTID= SW_TOKJOB= SW_TOKDEL= SW_TOKCUR=

# The switchboard's control socket, if it is not where `longwire-switchboard` puts it.
DT_SW_SOCK="${DT_SW_SOCK-}"
command -v dt_keep > /dev/null && dt_keep DT_SW_SOCK

# The switchboard's tokens file, if it is not where it would be looked for (docs/adr/0050).
DT_SW_TOKENS="${DT_SW_TOKENS-}"
command -v dt_keep > /dev/null && dt_keep DT_SW_TOKENS

SW_SCANMS=1000
SW_HISTMAX=120
SW_LINGER=6000		# how long a call that was put through, or ended, stays on the board (ms)
SW_RINGMAX=70000	# a ring nobody answered is gone from the switchboard after 65 s
SW_FEEDMAX=24
SW_SPARK=("${GL[spark1]}" "${GL[spark2]}" "${GL[spark3]}" "${GL[spark4]}" "${GL[spark5]}" "${GL[spark6]}" "${GL[spark7]}" "${GL[spark8]}")
declare -g SW_J SW_P SW_E SW_SVC SW_SVCT=-100

# --- reading the worker ------------------------------------------------------------------------------------------------

fn sw_sock() {
	if [ -n "$DT_SW_SOCK" ]; then
		ret "$DT_SW_SOCK"
	elif [ ! -S "${SB_DIR:-$HOME/.longwire/switchboard}/ctl" ] && [ -S "${LW_RUN:-/run}/longwire-switchboard/ctl" ]; then
		ret "${LW_RUN:-/run}/longwire-switchboard/ctl"		# the service's, which the group longwire may use (ADR 0032)
	else
		ret "${SB_DIR:-$HOME/.longwire/switchboard}/ctl"
	fi
}

# One value from the status (or whichever document was parsed last into SW_J), or the default.
fn sw_get(path, def = "") {
	local v

	if v := json get SW_J "$path" 2> /dev/null; then
		ret "$v"
	else
		ret "$def"
	fi
}

# Put a value from the parsed status into the window's state.
fn sw_set(int id, key, path, def = "") {
	local v

	v := sw_get "$path" "$def"
	SW[$id]["$key"]=$v
}

# 90 seconds as "1m", three days as "3d": the age of a heard-from node, and an uptime.
fn sw_ago(int s) {
	if [ "$s" -lt 10 ]; then
		ret "now"
	elif [ "$s" -lt 60 ]; then
		ret "${s}s"
	elif [ "$s" -lt 3600 ]; then
		ret "$((s / 60))m"
	elif [ "$s" -lt 172800 ]; then
		ret "$((s / 3600))h"
	else
		ret "$((s / 86400))d"
	fi
}

# Bytes a second as a person reads them: 0 B/s, 840 B/s, 12.4 kB/s, 3.1 MB/s.
fn sw_rate(int b) {
	if [ "$b" -lt 1000 ]; then
		ret "$b B/s"
	elif [ "$b" -lt 1000000 ]; then
		ret "$((b / 1000)).$(((b % 1000) / 100)) kB/s"
	else
		ret "$((b / 1000000)).$(((b % 1000000) / 100000)) MB/s"
	fi
}

# The nodes the list shows, in its order (the newest first), as registry positions: all of them, or those that match the search (a number,
# with or without its dashes, or a part of a name, in any case), and only those online if asked.
fn sw_filter(int id) {
	local n=${SW[$id]["ntotal"]:-0} q i k num nm out= only=${SW[$id]["only"]:-0}

	q := dt_searchq "$id" 2> /dev/null
	q=${q,,}
	q=${q//-/}
	for ((i = 0; i < n; i++)); do
		k=$((n - 1 - i))
		num=${SWN[$id][$k]["number"]}
		if [ "$only" = 1 ] && [ "${SWN[$id][$k]["online"]}" != true ]; then continue; fi
		if [ -n "$q" ]; then
			[ -n "$num" ] || continue
			nm=${SWN[$id][$k]["name"],,}
			num=${num//-/}
			[[ $num == *"$q"* ]] || [[ $nm == *"$q"* ]] || continue
		fi
		out+="$k "
	done
	SW[$id]["idx"]=$out
}

# Add a sample to a history kept as a string of numbers, and drop the oldest.
fn sw_push(int id, key, int v) {
	local -a a

	read -ra a <<< "${SW[$id]["$key"]} $v"
	[ "${#a[@]}" -gt "$SW_HISTMAX" ] && a=("${a[@]:$((${#a[@]} - SW_HISTMAX))}")
	SW[$id]["$key"]="${a[*]}"
}

# A history as block heights, the newest on the right, as many as fit.
fn sw_spark(hist, int width) {
	local -a v
	local max=1 i start s=

	read -ra v <<< "$hist"
	start=0
	[ "${#v[@]}" -gt "$width" ] && start=$((${#v[@]} - width))
	for ((i = start; i < ${#v[@]}; i++)); do
		[ "${v[$i]}" -gt "$max" ] && max=${v[$i]}
	done
	for ((i = start; i < ${#v[@]}; i++)); do
		s+="${SW_SPARK[$((${v[$i]} * 7 / max))]}"
	done
	while [ "${#s}" -lt "$width" ]; do s=" $s"; done
	ret "$s"
}

# --- the calls on the board --------------------------------------------------------------------------------------------

# Where a call between two numbers is on the board, or nothing.
fn sw_findcall(int id, from, to) {
	local i n=${SW[$id]["nf"]:-0}

	for ((i = n - 1; i >= 0; i--)); do
		if [ "${SWF[$id][$i]["from"]}" = "$from" ] && [ "${SWF[$id][$i]["to"]}" = "$to" ] && [ "${SWF[$id][$i]["state"]}" = ringing ]; then
			ret "$i"
			return 0
		fi
	done
	return 1
}

fn sw_addcall(int id, from, to, state, why, int now) {
	local n=${SW[$id]["nf"]:-0} i

	if [ "$n" -ge "$SW_FEEDMAX" ]; then		# the oldest goes
		for ((i = 1; i < n; i++)); do
			SWF[$id][$((i - 1))]["from"]=${SWF[$id][$i]["from"]}
			SWF[$id][$((i - 1))]["to"]=${SWF[$id][$i]["to"]}
			SWF[$id][$((i - 1))]["state"]=${SWF[$id][$i]["state"]}
			SWF[$id][$((i - 1))]["why"]=${SWF[$id][$i]["why"]}
			SWF[$id][$((i - 1))]["t"]=${SWF[$id][$i]["t"]}
		done
		n=$((n - 1))
	fi
	SWF[$id][$n]["from"]=$from
	SWF[$id][$n]["to"]=$to
	SWF[$id][$n]["state"]=$state
	SWF[$id][$n]["why"]=$why
	SWF[$id][$n]["t"]=$now
	SW[$id]["nf"]=$((n + 1))
}

# A call that has been through or ended for long enough is forgotten; a ring nobody answered is too.
fn sw_prune(int id, int now) {
	local i n=${SW[$id]["nf"]:-0} k=0 st t keep

	for ((i = 0; i < n; i++)); do
		st=${SWF[$id][$i]["state"]}
		t=${SWF[$id][$i]["t"]}
		keep=1
		if [ "$st" = ringing ]; then
			[ $((now - t)) -gt "$SW_RINGMAX" ] && keep=0
		else
			[ $((now - t)) -gt "$SW_LINGER" ] && keep=0
		fi
		if [ "$keep" = 1 ]; then
			if [ "$k" != "$i" ]; then
				SWF[$id][$k]["from"]=${SWF[$id][$i]["from"]}
				SWF[$id][$k]["to"]=${SWF[$id][$i]["to"]}
				SWF[$id][$k]["state"]=$st
				SWF[$id][$k]["why"]=${SWF[$id][$i]["why"]}
				SWF[$id][$k]["t"]=$t
			fi
			k=$((k + 1))
		fi
	done
	SW[$id]["nf"]=$k
}

# One event from the worker. Only the three about calls matter here.
fn sw_event(int id, line, int now) {
	local e from to why i

	json parse SW_E "$line" 2> /dev/null || return 0
	e := json get SW_E .event 2> /dev/null || return 0
	case $e in
	call-ring)
		from := json get SW_E .from
		to := json get SW_E .to
		sw_addcall "$id" "$from" "$to" ringing "" "$now" ;;
	call-go | call-end)
		from := json get SW_E .from
		to := json get SW_E .to
		why=
		[ "$e" = call-end ] && why := json get SW_E .reason 2> /dev/null
		if i := sw_findcall "$id" "$from" "$to"; then
			SWF[$id][$i]["state"]=through
			[ "$e" = call-end ] && SWF[$id][$i]["state"]=ended
			SWF[$id][$i]["why"]=$why
			SWF[$id][$i]["t"]=$now
		else
			sw_addcall "$id" "$from" "$to" "$([ "$e" = call-end ] && echo ended || echo through)" "$why" "$now"
		fi ;;
	esac
}

# Everything the worker has said since the last frame, without waiting for more.
fn sw_drain(int id, int now) {
	local line

	[ "${SW[$id]["fd"]}" = 1 ] || return 0
	while read -r -t 0 -u 7; do
		if ! read -r -u 7 line; then
			exec 7<&-
			SW[$id]["fd"]=0			# the worker went away; it is opened again when it is back
			return 0
		fi
		sw_event "$id" "$line" "$now"
	done
}

fn sw_feedopen(int id) {
	local sock

	[ "${SW[$id]["fd"]}" = 1 ] && return 0
	sock := sw_sock
	if exec 7< "/dev/longwire/events@$sock" 2> /dev/null; then
		SW[$id]["fd"]=1
	fi
}

# --- one look at the switchboard, once a second ------------------------------------------------------------------------

fn sw_scan(int id, int now) {
	local sock st pg cur total nx cnt i k v num nm lst on age

	sock := sw_sock
	if ! st := lw status --sock "$sock" 2> /dev/null || ! json parse SW_J "$st" 2> /dev/null; then
		SW[$id]["up"]=0
		return 0
	fi
	SW[$id]["up"]=1
	sw_set "$id" address .address
	sw_set "$id" code .code
	sw_set "$id" uptime .uptime 0
	sw_set "$id" numbers .numbers 0
	sw_set "$id" online .online 0
	sw_set "$id" ringing .calls_ringing 0
	sw_set "$id" policy .policy
	sw_set "$id" max .max_nodes 1024
	sw_set "$id" refused .code_refused
	sw_set "$id" issued .codes_issued 0
	k := sw_get .hs_shed 0
	v := sw_get .cookies_sent 0
	k=$((k + v))
	sw_set "$id" rings .rings 0
	sw_set "$id" through .put_through 0
	sw_set "$id" ended .ended 0
	sw_set "$id" regs .registrations 0
	sw_set "$id" bans .bans_active 0
	sw_set "$id" struck .strikes_given 0
	sw_set "$id" garbage .drop_garbage 0
	k := sw_get .rx_bytes 0
	v := sw_get .tx_bytes 0
	if [ -n "${SW[$id]["lastrx"]}" ] && [ -n "${SW[$id]["lastt"]}" ] && [ "$now" -gt "${SW[$id]["lastt"]}" ]; then
		i=$((now - ${SW[$id]["lastt"]}))
		SW[$id]["rin"]=$(((k - ${SW[$id]["lastrx"]}) * 1000 / i))
		SW[$id]["rout"]=$(((v - ${SW[$id]["lasttx"]}) * 1000 / i))
		[ "${SW[$id]["rin"]}" -ge 0 ] || SW[$id]["rin"]=0
		[ "${SW[$id]["rout"]}" -ge 0 ] || SW[$id]["rout"]=0
		sw_push "$id" hin "${SW[$id]["rin"]}"
		sw_push "$id" hout "${SW[$id]["rout"]}"
	fi
	SW[$id]["lastrx"]=$k
	SW[$id]["lasttx"]=$v
	SW[$id]["lastt"]=$now
	if [ "${SW[$id]["view"]}" = bans ]; then	# the bans, while they are being looked at
		SWB[$id]["n"]=0
		if pg := lw sb bans --sock "$sock" 2> /dev/null && json parse SW_P "$pg" 2> /dev/null; then
			cnt := json len SW_P .bans
			for ((i = 0; i < cnt; i++)); do
				SWB[$id]["k$i"] := json get SW_P ".bans[$i].key_id"
				SWB[$id]["s$i"] := json get SW_P ".bans[$i].seconds"
				SWB[$id]["l$i"] := json get SW_P ".bans[$i].level"
			done
			SWB[$id]["n"]=$cnt
		fi
	fi
	sw_push "$id" hon "${SW[$id]["online"]}"
	sw_push "$id" hhs "$((k - ${SW[$id]["lasths"]:-$k}))"
	SW[$id]["lasths"]=$k

	# a page of the registry each time, round and round: a switchboard of a thousand is walked in under a minute
	cur=${SW[$id]["ncur"]:-0}
	if pg := lw sb nodes "$cur" --sock "$sock" 2> /dev/null && json parse SW_P "$pg" 2> /dev/null; then
		total := json get SW_P .total
		cnt := json len SW_P .nodes
		for ((i = 0; i < cnt; i++)); do
			num := json get SW_P ".nodes[$i].number"
			nm := json get SW_P ".nodes[$i].name"
			lst := json get SW_P ".nodes[$i].listed"
			on := json get SW_P ".nodes[$i].online"
			age := json get SW_P ".nodes[$i].age"
			SWN[$id][$((cur + i))]["number"]=$num
			SWN[$id][$((cur + i))]["name"]=$nm
			SWN[$id][$((cur + i))]["listed"]=$lst
			SWN[$id][$((cur + i))]["online"]=$on
			SWN[$id][$((cur + i))]["age"]=$age
		done
		nx := json get SW_P .next
		[ "$nx" -ge "$total" ] || [ "$cnt" = 0 ] && nx=0
		SW[$id]["ncur"]=$nx
		SW[$id]["ntotal"]=$total
	fi
}

# A switchboard run as a service is named, not reached.
fn sw_service() {
	[ $((SECONDS - SW_SVCT)) -ge 10 ] || return 0
	SW_SVCT=$SECONDS
	SW_SVC=
	command -v systemctl > /dev/null || return 0
	SW_SVC=$(systemctl is-active longwire-switchboard.service 2> /dev/null)
}

# --- the tokens (docs/adr/0050) ----------------------------------------------------------------------------------------
# The invitations a switchboard spends at registration live in a file, not behind its control socket. The window finds the file: the one named in the
# settings; for the service, the --tokens in /etc/longwire/switchboard.conf (or its state folder's); else the one beside the switchboard run by hand.
# A service's file is its own user's: reading or changing it goes through please, which asks for the administrator's password.

fn sw_tokfile() {
	local sock line

	if [ -n "$DT_SW_TOKENS" ]; then ret "$DT_SW_TOKENS"; return 0; fi
	sock := sw_sock
	if [ "$sock" = "${LW_RUN:-/run}/longwire-switchboard/ctl" ]; then
		line=
		[ -r "${LONGWIRE_ETC:-/etc/longwire}/switchboard.conf" ] && read -r line < "${LONGWIRE_ETC:-/etc/longwire}/switchboard.conf"
		if [[ $line =~ --tokens\ ([^\ \"]+) ]]; then ret "${M[1]}"; return 0; fi
		ret "/var/lib/longwire-switchboard/tokens"
		return 0
	fi
	ret "${SB_DIR:-$HOME/.longwire/switchboard}/tokens"
}

# Whether the file needs the administrator: it cannot be read, or its folder cannot be written, by whoever runs the window.
fn sw_tokpriv(f) {
	local d=${f%/*}
	[ -z "${SW_TOKPRIV_TEST:-}" ] || return 0		# the tests run as a namespace's root, which can read any file

	if [ -e "$f" ]; then
		[ -r "$f" ] && [ -w "$d" ] && return 1
		return 0
	fi
	[ -d "$d" ] && [ -w "$d" ] && return 1
	[ ! -e "$d" ] && [ -w "${d%/*}" ] && return 1
	return 0
}

fn sw_tokcmd() {
	local c

	c=$(command -v longwire-switchboard 2> /dev/null)
	[ -n "$c" ] || c=${SW_TOKBIN:-}
	ret "$c"
}

# What the token command printed: one token per line (a reserved number may follow it), into the list.
fn sw_tokparse(int id, f) {
	local line i=0

	SWT[$id]["n"]=0
	[ -r "$f" ] || return 0
	while IFS= read -r line; do
		line=${line%$'\r'}			# a pty's line ends
		case $line in *assword*) continue ;; esac	# the prompt please's polkit printed, on the same terminal
		[[ $line =~ ^[A-Za-z0-9._~+=,:@/-]+( [0-9-]+)?$ ]] || continue
		SWT[$id]["t$i"]=$line
		i=$((i + 1))
	done < "$f"
	SWT[$id]["n"]=$i
	SWT[$id]["loaded"]=1
}

# Run the token command (list, new or remove): at once when the file is the person's own, else as a job through please.
fn sw_tokrun(int id, then, ...args) {
	local f c out

	f := sw_tokfile
	c := sw_tokcmd
	if [ -z "$c" ]; then dt_notep high "longwire-switchboard is not installed here: the longwire package has it"; return 1; fi
	if sw_tokpriv "$f"; then
		[ -z "$SW_TOKJOB" ] || return 0
		SW_TOKJOB := dt_ptyjob switchboard tokens "$then" sw_tokprompt please "$c" token "${args[@]}" --tokens "$f"
		[ -n "$SW_TOKJOB" ] || { dt_notep high "Could not start please"; return 1; }
		return 0
	fi
	dt_jobdir || return 1
	out="$DTJ_DIR/swtok.out"
	"$c" token "${args[@]}" --tokens "$f" > "$out" 2>&1
	"$then" 0 $? "$out"
}

# polkit names the account it asks for ("Authenticating as: ..."): the dialog says that one, short enough to fit.
fn sw_tokprompt(int n, text) {
	local line who= name user
	case $text in *"assword: "|*"assword:") ;; *) return 1 ;; esac
	[ -n "${DTJ[$n]["asking"]}" ] && return 0
	DTJ[$n]["asking"]=1
	while IFS= read -r line; do
		case $line in "Authenticating as: "*) who=${line#Authenticating as: } ;; esac
	done < "$DTJ_DIR/$n.out" 2> /dev/null
	name=${who%%" ("*}; name=${name%%,*}
	user=${who##*"("}; user=${user%%")"*}
	if [ -z "$who" ]; then
		dt_ask "Password" "Password:" "" sw_tokpw "For the switchboard's tokens" 1 54 sw_tokpwno > /dev/null
	elif [ "$user" = root ] || [ "$user" = "$who" ]; then
		dt_ask "Root's password" "Password:" "" sw_tokpw "For the switchboard's tokens" 1 54 sw_tokpwno > /dev/null
	else
		dt_ask "Password for ${name:-$user} ($user)" "Password:" "" sw_tokpw "For the switchboard's tokens" 1 54 sw_tokpwno > /dev/null
	fi
	return 0
}

fn sw_tokpw(v, int? id = "") {
	local n=$SW_TOKJOB

	[ -n "$n" ] && [ -n "${DTJ[$n]["pty"]}" ] || return 0
	pty write "${DTJ[$n]["pty"]}" "$v"$'\r'
	DTJ[$n]["asking"]=
	return 0
}

fn sw_tokpwno(int? id = "") {
	local n=$SW_TOKJOB

	[ -n "$n" ] && [ -n "${DTJ[$n]["pty"]}" ] || return 0
	DTJ[$n]["cancelled"]=1
	pty write "${DTJ[$n]["pty"]}" $'\003' 2> /dev/null
	return 0
}

# A job's output: a pty job's file, or the one a direct run wrote.
fn sw_tokout(int n, out = "") {
	if [ -n "$out" ]; then ret "$out"; return 0; fi
	dt_jobfile "$n" out
}

fn sw_toklisted(int n, int st, out = "") {
	local f id=$SW_TOKCUR

	SW_TOKJOB=
	f := sw_tokout "$n" "$out"
	if [ "$st" != 0 ]; then
		if [ -n "${DTJ[$n]["cancelled"]-}" ]; then dt_notep low "Cancelled"; else
			SWT[$id]["n"]=0; SWT[$id]["loaded"]=1		# no file yet: no tokens
		fi
		return 0
	fi
	sw_tokparse "$id" "$f"
	return 0
}

fn sw_tokmade(int n, int st, out = "") {
	local f id=$SW_TOKCUR t=

	SW_TOKJOB=
	f := sw_tokout "$n" "$out"
	if [ "$st" != 0 ]; then
		[ -n "${DTJ[$n]["cancelled"]-}" ] && dt_notep low "Cancelled" || dt_notep high "Could not make a token"
		return 0
	fi
	if [ -r "$f" ]; then
		while IFS= read -r t; do t=${t%$'\r'}; [[ $t =~ ^[0-9a-f]{32}$ ]] && break; t=; done < "$f"
	fi
	SWT[$id]["new"]=$t
	dt_notep low "A new token: %s (c copies it; give it to one machine)" "$t"
	sw_tokrun "$id" sw_toklisted list
}

fn sw_tokgone(int n, int st, out = "") {
	local id=$SW_TOKCUR

	SW_TOKJOB=
	if [ "$st" != 0 ]; then
		[ -n "${DTJ[$n]["cancelled"]-}" ] && dt_notep low "Cancelled" || dt_notep high "Could not remove the token"
		return 0
	fi
	dt_notep low "Token removed"
	sw_tokrun "$id" sw_toklisted list
}

fn sw_tokdelask(int id) {
	local sel=${SW[$id]["sel"]:-0}

	[ "${SWT[$id]["n"]:-0}" -gt 0 ] || { dt_notep low "No token chosen"; return 0; }
	SW_TOKDEL=${SWT[$id]["t$sel"]%% *}
	SW_TOKCUR=$id
	dt_confirm "Remove token ${SW_TOKDEL:0:8}${GL[ellipsis]}? It stops working." sw_tokdeldo
}

fn sw_tokdeldo() {
	[ -n "$SW_TOKDEL" ] || return 0
	sw_tokrun "$SW_TOKCUR" sw_tokgone remove "$SW_TOKDEL"
	SW_TOKDEL=
}

fn swb_settokens(text, int? id = "") {
	DT_SW_TOKENS=$text
	command -v dt_save > /dev/null && dt_save
	return 0
}

# --- the window ---------------------------------------------------------------------------------------------------------

fn switchboard_open(int id) {
	SW[$id]["top"]=0
	SW[$id]["sel"]=0
	SW[$id]["fd"]=0
	SW[$id]["nf"]=0
	SW[$id]["only"]=0
	SW[$id]["view"]=nodes
	dt_searchclear "$id"
}

fn switchboard_close(int id) {
	[ "${SW[$id]["fd"]}" = 1 ] && exec 7<&-
	# nothing is kept: not the calls, not the nodes
	unset SWF[$id] SWN[$id] SW[$id] SWB[$id] SWT[$id]
	dt_searchfree "$id"
	return 0
}

# Draw a line of text in a pen, clipped to the window's width.
fn sw_put(int id, int r, int c, text) {
	console put -p "w$id" "$r" "$c" "$text"
}

# The calls, newest at the bottom, each as a short wire with a lamp running along it while it rings.
fn sw_drawcalls(int id, int r0, int rows, int w, int now) {
	local i n=${SW[$id]["nf"]:-0} first r st from to why age link len pos j

	first=0
	[ "$n" -gt "$rows" ] && first=$((n - rows))
	len=7
	r=$r0
	for ((i = first; i < n; i++)); do
		st=${SWF[$id][$i]["state"]}
		from=${SWF[$id][$i]["from"]}
		to=${SWF[$id][$i]["to"]}
		why=${SWF[$id][$i]["why"]}
		age=$(((now - ${SWF[$id][$i]["t"]}) / 1000))
		link=
		case $st in
		ringing)
			pos=$(((now / 160) % len))
			for ((j = 0; j < len; j++)); do
				if [ "$j" = "$pos" ]; then link+="${GL[circle]}"; else link+="${GL[dashh]}"; fi
			done
			console pen "$DT_WARN" "$DT_FACE" ;;
		through)
			for ((j = 0; j < len; j++)); do link+="${GL[minus]}"; done
			console pen "$DT_INFO" "$DT_FACE" bold ;;
		*)
			for ((j = 0; j < len - 1; j++)); do link+="${GL[hline]}"; done
			link+="${GL[cross]}"
			console pen "$DT_DIM" "$DT_FACE" ;;
		esac
		case $st in
		ringing) why="ringing ${age}s" ;;
		through) why="put through" ;;
		*) why=${why:-ended} ;;
		esac
		sw_put "$id" "$r" 2 "$from $link $to  $why"
		r=$((r + 1))
	done
	console pen "$DT_INK" "$DT_FACE"
}

fn switchboard_draw(int id, int h, int w, int row, int col) {
	local now sock i k num r r0 vis top sel n total on max bw filled bar nw name lamp line ago sp1 sp2 half fr rin rout srows q tf
	local -a idx

	now := dt_ms
	if ! need longwire 2> /dev/null; then
		console pen "$DT_INK" "$DT_FACE"
		sw_put "$id" 2 2 "The longwire module is not installed."
		sw_put "$id" 3 2 "Find longwire in the Catalogue (Commands), or install the package."
		return 0
	fi
	if [ -z "${SW[$id]["scant"]}" ] || [ $((now - ${SW[$id]["scant"]})) -ge "$SW_SCANMS" ]; then
		sw_scan "$id" "$now"
		sw_feedopen "$id"
		SW[$id]["scant"]=$now
	fi
	sw_drain "$id" "$now"
	sw_prune "$id" "$now"
	console pen "$DT_INK" "$DT_FACE"
	if [ "${SW[$id]["up"]}" != 1 ]; then
		sw_service
		sock := sw_sock
		sw_put "$id" 2 2 "No switchboard answers at $sock."
		if [ "$SW_SVC" = active ]; then
			console pen "$DT_WARN" "$DT_FACE"
			sw_put "$id" 4 2 "longwire-switchboard.service is running here, as another user."
			sw_put "$id" 5 2 "Its control socket is open to the group longwire; you are not in it, or have not logged in since."
			console pen "$DT_DIM" "$DT_FACE"
			sw_put "$id" 7 2 "Join it with: please usermod -aG longwire YOURNAME   (then log in again)"
		else
			console pen "$DT_DIM" "$DT_FACE"
			sw_put "$id" 4 2 "Start one with: longwire-switchboard --registry none"
			sw_put "$id" 5 2 "or press s to say where its control socket is."
		fi
		dt_want "$SW_SCANMS"
		return 0
	fi

	# --- the head: who it is, how full it is -----------------------------------------------------------------------
	console pen "$DT_INK" "$DT_FACE" bold
	line="${GL[circle]} ${SW[$id]["address"]:0:30}${GL[ellipsis]}"
	[ -n "${SW[$id]["code"]}" ] && line+="  code +${SW[$id]["code"]}"
	ago := sw_ago "${SW[$id]["uptime"]}"
	line+="  up $ago  policy ${SW[$id]["policy"]}"
	sw_put "$id" 1 1 "${line:0:$((w - 1))}"
	on=${SW[$id]["online"]}
	max=${SW[$id]["max"]}
	[ "$max" -ge 1 ] || max=1
	bw=$((w - 34))
	[ "$bw" -lt 8 ] && bw=8
	filled=$((on * bw / max))
	[ "$on" -gt 0 ] && [ "$filled" = 0 ] && filled=1
	bar=
	for ((i = 0; i < bw; i++)); do
		if [ "$i" -lt "$filled" ]; then bar+="${GL[block]}"; else bar+="${GL[light]}"; fi
	done
	console pen "$DT_INK" "$DT_FACE"
	sw_put "$id" 2 1 "online $(printf '%4d' "$on")/$max "
	console pen "$DT_GOOD" "$DT_FACE"
	sw_put "$id" 2 $((16 + ${#max})) "$bar"
	console pen "$DT_INK" "$DT_FACE"
	sw_put "$id" 2 $((17 + ${#max} + bw)) " ringing ${SW[$id]["ringing"]}"

	# --- traffic in and out, then since it started ---------------------------------------------------------------
	half=$(((w - 2) / 2))
	rin := sw_rate "${SW[$id]["rin"]:-0}"
	rout := sw_rate "${SW[$id]["rout"]:-0}"
	console pen "$DT_DIM" "$DT_FACE"
	sw_put "$id" 3 1 "in"
	sw_put "$id" 3 $((half + 2)) "out"
	console pen "$DT_INK" "$DT_FACE" bold
	sw_put "$id" 3 4 "$rin"
	sw_put "$id" 3 $((half + 6)) "$rout"
	sp1 := sw_spark "${SW[$id]["hin"]}" "$half"
	sp2 := sw_spark "${SW[$id]["hout"]}" $((w - 2 - half - 1))
	console pen "$DT_INFO" "$DT_FACE"
	sw_put "$id" 4 1 "$sp1"
	console pen "$DT_GOOD" "$DT_FACE"
	sw_put "$id" 4 $((half + 2)) "$sp2"
	r=5
	if [ "$h" -ge 22 ]; then			# online and the handshake load, where there is room
		console pen "$DT_DIM" "$DT_FACE"
		sw_put "$id" 5 1 "online"
		sw_put "$id" 5 $((half + 2)) "handshake load"
		sp1 := sw_spark "${SW[$id]["hon"]}" "$half"
		sp2 := sw_spark "${SW[$id]["hhs"]}" $((w - 2 - half - 1))
		console pen "$DT_GOOD" "$DT_FACE"
		sw_put "$id" 6 1 "$sp1"
		console pen "$DT_WARN" "$DT_FACE"
		sw_put "$id" 6 $((half + 2)) "$sp2"
		r=7
	fi
	line="registered ${SW[$id]["regs"]:-0}  rings ${SW[$id]["rings"]:-0}  through ${SW[$id]["through"]:-0}  ended ${SW[$id]["ended"]:-0}  struck ${SW[$id]["struck"]:-0}"
	console pen "$DT_DIM" "$DT_FACE"
	sw_put "$id" "$r" 1 "${line:0:$((w - 12))}"
	if [ "${SW[$id]["bans"]:-0}" -gt 0 ]; then console pen "$DT_WARN" "$DT_FACE" bold; else console pen "$DT_DIM" "$DT_FACE"; fi
	sw_put "$id" "$r" $((w - 10)) "bans ${SW[$id]["bans"]:-0}"
	r=$((r + 1))
	if [ -n "${SW[$id]["refused"]}" ]; then
		console pen "$DT_WARN" "$DT_FACE"
		sw_put "$id" "$r" 1 "no short code: ${SW[$id]["refused"]}"
		r=$((r + 1))
	fi
	r0=$r

	# --- the board: the nodes (newest at the top), or the bans --------------------------------------------------
	fr=5
	[ "$h" -lt 24 ] && fr=3
	srows := dt_searchrows "$id"
	vis=$((h - r0 - 1 - fr - 2 - srows))
	[ "$vis" -lt 1 ] && vis=1
	SW[$id]["vis"]=$vis
	q=
	if [ "${SW[$id]["view"]}" = tokens ]; then
		n=${SWT[$id]["n"]:-0}
		console pen "$DT_INK" "$DT_FACE" bold
		sw_put "$id" "$r0" 1 "Tokens ($n unspent)   n new   x remove   c copy   t back"
	elif [ "${SW[$id]["view"]}" = bans ]; then
		n=${SWB[$id]["n"]:-0}
		console pen "$DT_INK" "$DT_FACE" bold
		sw_put "$id" "$r0" 1 "Bans ($n)   x lifts the one chosen   b back to the nodes"
	else
		sw_filter "$id"
		read -ra idx <<< "${SW[$id]["idx"]}"
		n=${#idx[@]}
		total=${SW[$id]["ntotal"]:-0}
		line="Nodes ($total)"
		[ "$n" != "$total" ] && line="Nodes ($n of $total)"
		[ "${SW[$id]["only"]}" = 1 ] && line+="   online only"
		q := dt_searchq "$id"
		[ -n "$q" ] && line+="   matching \"$q\""
		console pen "$DT_INK" "$DT_FACE" bold
		sw_put "$id" "$r0" 1 "$line"
	fi
	top=${SW[$id]["top"]:-0}
	[ "$top" -gt $((n - vis)) ] && top=$((n - vis))
	[ "$top" -lt 0 ] && top=0
	SW[$id]["top"]=$top
	sel=${SW[$id]["sel"]:-0}
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	[ "$sel" -lt 0 ] && sel=0
	SW[$id]["sel"]=$sel
	SW[$id]["n"]=$n
	nw=$((w - 2 - 2 - 11 - 1 - 2 - 5))
	[ "$nw" -lt 6 ] && nw=6
	r=$((r0 + 1))
	for ((i = top; r < r0 + 1 + vis; i++, r++)); do
		if [ "$i" -ge "$n" ]; then break; fi
		if [ "${SW[$id]["view"]}" = tokens ]; then
			line=${SWT[$id]["t$i"]}
			[ "${line%% *}" = "${SWT[$id]["new"]-}" ] && line+="   (new)"
			if [ "$i" = "$sel" ]; then console pen "$DT_SELINK" "$DT_ACTIVE" bold; else console pen "$DT_INK" "$DT_FACE"; fi
			sw_put "$id" "$r" 1 " ${GL[dot]} $line"
			continue
		fi
		if [ "${SW[$id]["view"]}" = bans ]; then
			ago := sw_ago "${SWB[$id]["s$i"]:-0}"
			line="key ${SWB[$id]["k$i"]:0:16}${GL[ellipsis]}  $ago left  (ban ${SWB[$id]["l$i"]} in a row)"
			if [ "$i" = "$sel" ] && ! dt_searchon "$id"; then console pen "$DT_SELINK" "$DT_ACTIVE" bold; else console pen "$DT_WARN" "$DT_FACE"; fi
			sw_put "$id" "$r" 1 " ${GL[cross]} $line"
			continue
		fi
		k=${idx[$i]}
		num=${SWN[$id][$k]["number"]}
		if [ -z "$num" ]; then
			console pen "$DT_DIM" "$DT_FACE"
			sw_put "$id" "$r" 2 "${GL[ellipsis]}"
			continue
		fi
		name=${SWN[$id][$k]["name"]}
		if [ -n "$name" ]; then name="\"$name\""; else name="${GL[dash]}"; fi
		[ "${#name}" -gt "$nw" ] && name="${name:0:$((nw - 1))}${GL[ellipsis]}"
		name := str pad "$name" "$nw"
		ago := sw_ago "${SWN[$id][$k]["age"]:-0}"
		ago=$(printf '%5s' "$ago")
		lamp="${GL[dot]}"
		if [ "${SWN[$id][$k]["online"]}" = true ]; then lamp="${GL[circle]}"; fi
		line="$num $name"
		[ "${SWN[$id][$k]["listed"]}" = true ] && line+=" ${GL[star]}" || line+="  "
		line+=" $ago"
		if [ "$i" = "$sel" ] && ! dt_searchon "$id"; then
			console pen "$DT_SELINK" "$DT_ACTIVE" bold
		elif [ "${SWN[$id][$k]["online"]}" = true ]; then
			console pen "$DT_GOOD" "$DT_FACE"
		else
			console pen "$DT_DIM" "$DT_FACE"
		fi
		sw_put "$id" "$r" 1 " $lamp $line"
	done
	if [ "$n" = 0 ]; then
		console pen "$DT_DIM" "$DT_FACE"
		if [ "${SW[$id]["view"]}" = tokens ]; then
			tf := sw_tokfile
			if [ "${SWT[$id]["loaded"]-}" != 1 ]; then
				sw_put "$id" $((r0 + 1)) 2 "The tokens in $tf belong to the switchboard's service: r reads them (the administrator's password)."
			else
				sw_put "$id" $((r0 + 1)) 2 "No unspent tokens in $tf: registration needs one if the switchboard runs with --tokens. n makes one."
			fi
		elif [ "${SW[$id]["view"]}" = bans ]; then
			sw_put "$id" $((r0 + 1)) 2 "Nobody is banned."
		elif [ -n "$q" ] || [ "${SW[$id]["only"]}" = 1 ]; then
			sw_put "$id" $((r0 + 1)) 2 "No node matches."
		fi
	fi
	[ "${DT_SWBAR-1}" = 1 ] && dt_scrollbar "$id" $((r0 + 1)) $((w - 1)) "$vis" "$n" "$vis" "$top" list

	# --- the wire: calls being set up ------------------------------------------------------------------------------
	r=$((r0 + 1 + vis + 1))
	console pen "$DT_INK" "$DT_FACE" bold
	sw_put "$id" "$r" 1 "Calls"
	sw_drawcalls "$id" $((r + 1)) "$fr" "$w" "$now"
	dt_searchdraw "$id" "$h" "$w"
	if [ "$(( ${SW[$id]["ringing"]:-0} ))" -gt 0 ] || [ "${SW[$id]["nf"]:-0}" -gt 0 ]; then
		dt_want 150
	else
		dt_want "$SW_SCANMS"
	fi
}

fn switchboard_key(int id, key) {
	local n=${SW[$id]["n"]:-0} vis=${SW[$id]["vis"]:-1} sel=${SW[$id]["sel"]:-0} top=${SW[$id]["top"]:-0} q0 q1 tf

	q0 := dt_searchq "$id"
	if [ "${SW[$id]["view"]}" = nodes ] && dt_searchkey "$id" "$key"; then	# `/` and what is typed after it: the search, on the window's last row
		q1 := dt_searchq "$id"
		if [ "$q0" != "$q1" ]; then
			SW[$id]["sel"]=0
			SW[$id]["top"]=0
		fi
		return 0
	fi
	case $key in
	up | k) sel=$((sel - 1)) ;;
	down | j) sel=$((sel + 1)) ;;
	pgup | pageup) sel=$((sel - vis)) ;;
	pgdn | pagedown) sel=$((sel + vis)) ;;
	home) sel=0 ;;
	end) sel=$((n - 1)) ;;
	o) [ "${SW[$id]["only"]}" = 1 ] && SW[$id]["only"]=0 || SW[$id]["only"]=1; SW[$id]["sel"]=0; SW[$id]["top"]=0; return 0 ;;
	b) if [ "${SW[$id]["view"]}" = bans ]; then SW[$id]["view"]=nodes; else SW[$id]["view"]=bans; SWB[$id]["n"]=0; SW[$id]["scant"]=; fi
	   SW[$id]["sel"]=0; SW[$id]["top"]=0; return 0 ;;
	t) if [ "${SW[$id]["view"]}" = tokens ]; then SW[$id]["view"]=nodes; else
	       SW[$id]["view"]=tokens; SWT[$id]["loaded"]=; SWT[$id]["n"]=0
	       tf := sw_tokfile
	       sw_tokpriv "$tf" || { SW_TOKCUR=$id; sw_tokrun "$id" sw_toklisted list; }	# the person's own file is read at once; a service's when asked (r)
	   fi
	   SW[$id]["sel"]=0; SW[$id]["top"]=0; return 0 ;;
	r) [ "${SW[$id]["view"]}" = tokens ] || return 1; SW_TOKCUR=$id; sw_tokrun "$id" sw_toklisted list; return 0 ;;
	n) [ "${SW[$id]["view"]}" = tokens ] || return 1; SW_TOKCUR=$id; sw_tokrun "$id" sw_tokmade new 1; return 0 ;;
	T) dt_ask "Tokens file" "File" "$DT_SW_TOKENS" swb_settokens "its --tokens file; empty to find it"; return 0 ;;
	x | delete) if [ "${SW[$id]["view"]}" = tokens ]; then sw_tokdelask "$id"; else sw_liftask "$id"; fi; return 0 ;;
	c) command -v dt_editdo > /dev/null && dt_editdo copy; return 0 ;;	# the desktop's own Copy, which asks switchboard_copy
	s) dt_ask "Switchboard socket" "Socket" "$DT_SW_SOCK" swb_setsock "its control socket; empty for the usual"; return 0 ;;
	*) return 1 ;;
	esac
	sel := dt_scrollsel "$sel" "$n"
	top := dt_scrollfit "$top" "$n" "$vis" "$sel"
	SW[$id]["sel"]=$sel
	SW[$id]["top"]=$top
	return 0
}

# Edit > Find, and `/`: search the nodes by number or name.
fn switchboard_find(int id) {
	[ "${SW[$id]["view"]}" = bans ] && SW[$id]["view"]=nodes
	dt_searchopen "$id"
	return 0
}

# Lift the ban chosen in the bans view, after asking. Only the switchboard's owner may (the group may look).
fn sw_liftask(int id) {
	local sel=${SW[$id]["sel"]:-0}

	if [ "${SW[$id]["view"]}" != bans ] || [ "${SWB[$id]["n"]:-0}" = 0 ]; then
		dt_notep low "Press b for the bans first; x lifts the one chosen there."
		return 0
	fi
	SW_LIFT=${SWB[$id]["k$sel"]}
	SW_LIFTID=$id
	dt_confirm "Lift the ban on ${SW_LIFT:0:16}${GL[ellipsis]}?" sw_liftdo
}

fn sw_liftdo() {
	local sock out

	[ -n "$SW_LIFT" ] || return 0
	sock := sw_sock
	if out := lw sb unban "${SW_LIFT:0:16}" --sock "$sock" 2>&1; then
		dt_notep low "Ban lifted on ${SW_LIFT:0:16}${GL[ellipsis]}"
		SW[$SW_LIFTID]["scant"]=
	else
		dt_notep high "Could not lift it: ${out:-only the switchboard's owner may} (on the switchboard: longwire-switchboard bans clear ${SW_LIFT:0:16})"
	fi
	SW_LIFT=
}

# The menus: every key the window answers is here, named (docs/adr/0049).
switchboard_menus() {
	local id=$DT_FOCUS mo=0 mb=0 mt=0

	[ "${SW[$id]["only"]}" = 1 ] && mo=1
	[ "${SW[$id]["view"]}" = bans ] && mb=1
	[ "${SW[$id]["view"]}" = tokens ] && mt=1

	dt_menu "File"
	dt_item "Switchboard Socket${GL[ellipsis]}" s switchboard_key "$id" s
	dt_item "Tokens File${GL[ellipsis]}" T switchboard_key "$id" T
	dt_sep
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
	dt_menu "View"
	dt_mark "Online Only" o "$mo" switchboard_key "$id" o
	dt_mark "Bans" b "$mb" switchboard_key "$id" b
	dt_mark "Tokens" t "$mt" switchboard_key "$id" t
	dt_sep
	dt_item "Search${GL[ellipsis]}" f switchboard_find "$id"
	dt_menu "Node"
	dt_item "Copy Number" c dt_editdo copy
	if [ "${SW[$id]["view"]}" = bans ]; then
		dt_item "Lift Ban${GL[ellipsis]}" x switchboard_key "$id" x
	else
		dt_dim "Lift Ban${GL[ellipsis]}"
	fi
	dt_menu "Tokens"
	if [ "$mt" = 1 ]; then
		dt_item "New Token" n switchboard_key "$id" n
		dt_item "Remove Token${GL[ellipsis]}" x switchboard_key "$id" x
		dt_item "Copy Token" c dt_editdo copy
		dt_item "Read Again" r switchboard_key "$id" r
	else
		dt_item "Show Tokens" t switchboard_key "$id" t
		dt_dim "New Token"
		dt_dim "Remove Token${GL[ellipsis]}"
	fi
}

fn swb_setsock(text, int? id = "") {
	DT_SW_SOCK=$text
	command -v dt_save > /dev/null && dt_save
	return 0
}

fn switchboard_wheel(int id, dir, int? r = "", int? c = "") {
	local top=${SW[$id]["top"]:-0} n=${SW[$id]["n"]:-0} vis=${SW[$id]["vis"]:-1}

	top := dt_scrollmove "$dir" "$top" "$n" "$vis" "$DT_SCROLLWHEEL" || return 1
	SW[$id]["top"]=$top
	return 0
}

fn switchboard_scroll(int id, key, int top) { SW[$id]["top"]=$top; }

# Edit > Copy: the chosen node's number (or, among the bans, the banned key).
fn switchboard_copy(int id) {
	local n=${SW[$id]["n"]:-0} sel=${SW[$id]["sel"]:-0} k
	local -a idx

	[ "$n" -gt 0 ] || return 1
	if [ "${SW[$id]["view"]}" = tokens ]; then
		[ -n "${SWT[$id]["t$sel"]}" ] || return 1
		ret "${SWT[$id]["t$sel"]%% *}"		# the token itself, to hand to one machine
		return 0
	fi
	if [ "${SW[$id]["view"]}" = bans ]; then
		[ -n "${SWB[$id]["k$sel"]}" ] || return 1
		ret "${SWB[$id]["k$sel"]}"		# the banned key, whole, for `bans clear`
		return 0
	fi
	read -ra idx <<< "${SW[$id]["idx"]}"
	k=${idx[$sel]}
	[ -n "${SWN[$id][$k]["number"]}" ] || return 1
	ret "${SWN[$id][$k]["number"]}"
}

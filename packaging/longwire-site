#!/usr/bin/hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# longwire-site NIC ARGSFILE [UID]  -- as root, make this machine a site node for the network card NIC: write /etc/longwire/NIC.conf from the options in
# ARGSFILE (one line of them), enable and start longwire@NIC, and let the user who asked use its control socket. The Control Panel's Turn on runs it
# through pkexec (polkit's action org.longwire.site names this file) when a profile splices a card, so that nobody edits a service file by hand.
# longwire-site --stop NIC          stops and disables longwire@NIC.
#
# The user's file is read once and checked word by word: only --switchboard, --token, --name, --answer and --listed get through, each with a value of
# the shape it must have, so a person who may run this can start a site node and nothing else. The node itself still runs unprivileged
# with CAP_NET_RAW alone (docs/adr/0004, the unit's own limits).
#
# It is a hibr script like the rest of longwire (docs/adr/0041). As root, hibr consults only its install directory for modules and reads
# nothing of the caller's environment for them; pkexec cleans the environment besides. The LONGWIRE_* variables below are for the tests.

fn fail(msg, int code = 2) {
	echo "longwire-site: $msg" >&2
	exit $code
}

# A card name this helper may touch: letters, digits and . _ -, at most 15, and not the loopback or one of our own jacks.
fn card_ok(nic) {
	[[ $nic =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || return 1
	[ "$nic" != lo ] || return 1
	[[ $nic =~ ^lw[0-9] ]] && return 1
	return 0
}

if [ "${1:-}" = "--stop" ]; then
	nic=${2:-}
	card_ok "$nic" || fail "not a card I may stop: '$nic'"
	systemctl disable --now "longwire@$nic.service" || exit 1
	echo "longwire-site: longwire@$nic is stopped and will not start again at boot"
	exit 0
fi

nic=${1:-}
file=${2:-}
uid=${PKEXEC_UID:-${3:-}}
card_ok "$nic" || fail "not a card I may splice: '$nic' (a real network card, not lo or a jack)"
[ -d "${LONGWIRE_SYSNET:-/sys/class/net}/$nic" ] || fail "there is no network card called $nic" 3
[[ $uid =~ ^[0-9]+$ ]] || fail "no user to give the control socket to (pass a uid, or run it through pkexec)"
[ "$uid" -ne 0 ] || [ -n "${LONGWIRE_SITE_ROOT_OK:-}" ] || fail "a site node's control socket goes to a user, not root"
[ -f "$file" ] && [ ! -L "$file" ] || fail "$file: not a plain file"
[ "$(stat -c %u "$file")" = "$uid" ] || fail "$file: not the user's own file"
[ "$(stat -c %s "$file")" -le 2048 ] || fail "$file: too long"

line=
read -r line < "$file"			# read once; everything after this is the copy
words=()
read -r -a words <<< "$line"
out=
i=0
n=${#words[@]}
while [ $i -lt $n ]; do
	opt=${words[$i]}
	i=$((i + 1))
	case $opt in
	--listed) out="$out --listed"; continue ;;
	--switchboard | --token | --name | --answer) ;;
	*) fail "option '$opt' is not one a site node takes from here" ;;
	esac
	[ $i -lt $n ] || fail "$opt wants a value"
	val=${words[$i]}
	i=$((i + 1))
	case $opt in
	--switchboard)
		# HOST:PORT/KEY, nothing else
		[[ $val =~ ^[A-Za-z0-9._-]+:[0-9]+/[A-Za-z0-9]+$ ]] || fail "--switchboard wants HOST:PORT/KEY" ;;
	--token)
		# visible characters only, and none a service file or a command line could take for something else
		[[ $val =~ ^[A-Za-z0-9._~+=,:@/-]+$ ]] || fail "that token has a character a service file cannot carry" ;;
	--name)
		[[ $val =~ ^[A-Za-z0-9._-]{1,32}$ ]] || fail "--name for a site node is letters, digits, . _ - (no spaces), at most 32" ;;
	--answer)
		case $val in ask | known | auto | never) ;; *) fail "--answer is ask, known, auto or never" ;; esac ;;
	esac
	out="$out $opt $val"
done

conf=${LONGWIRE_ETC:-/etc/longwire}/$nic.conf
umask 077
mkdir -p "$(dirname "$conf")" || exit 1
printf 'ARGS="%s"\n' "${out# }" > "$conf.new" || exit 1
chmod 600 "$conf.new"
mv "$conf.new" "$conf" || exit 1
if systemctl is-active --quiet "longwire@$nic.service"; then
	systemctl restart "longwire@$nic.service" || exit 1
else
	systemctl enable --now "longwire@$nic.service" || exit 1
fi

run=${LONGWIRE_RUN_DIR:-/run/longwire}/$nic
i=0
while [ ! -S "$run/ctl" ] && [ $i -lt 150 ]; do		# up to 15 s for the service to open its control socket
	sleep 0.1
	i=$((i + 1))
done
[ -S "$run/ctl" ] || fail "longwire@$nic started, but its control socket did not appear (systemctl status longwire@$nic)" 4
if command -v setfacl > /dev/null; then			# the user need not log in again to be in the group longwire
	setfacl -m "u:$uid:x" "$run" || exit 1
	setfacl -m "u:$uid:rw" "$run/ctl" || exit 1
	echo "longwire-site: longwire@$nic is running; user $uid may use its control socket"
else
	echo "longwire-site: longwire@$nic is running; join the group longwire (sudo usermod -aG longwire YOU) and log in again to use it from the desktop"
fi

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<policyconfig>
  <vendor>longwire</vendor>
  <vendor_url>https://git.home.arpa/itdlabs/longwire</vendor_url>
  <action id="org.longwire.site">
    <description>Make this computer a longwire site node for a network card</description>
    <message>Authentication is required to start a longwire site node (a service that bridges a network card)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/longwire/site</annotate>
  </action>
</policyconfig>

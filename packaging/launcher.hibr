#!/usr/bin/hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# The launcher: /usr/bin/longwire and /usr/bin/longwire-switchboard are this file, twice. The package ships the module;
# the two scripts come from hibr's catalogue (`catalogue install cli/longwire cli/longwire-switchboard`), one route for them and no
# second copy to keep in step. This finds the script the catalogue placed, yours first, then the machine's, and runs it.
# They are commands, not desktop apps, so the catalogue files them under its `cli` kind (docs/adr/0029); a copy installed
# as an app is found too, after those.
#
# LONGWIRE_SCRIPTS (a directory) goes first when set: for a test, or a checkout.
# It is a hibr script like the rest of longwire (docs/adr/0041); the script it finds is run by the same hibr that runs this.

name=${0##*/}
want=$name.hibr

fn find_script() {
	local d f
	for d in "${LONGWIRE_SCRIPTS:-}" \
		 "${XDG_DATA_HOME:-$HOME/.local/share}/hibr/cli" \
		 "${HIBR_SYSDIR:-/var/lib/hibr}/cli" \
		 "${XDG_CONFIG_HOME:-$HOME/.config}/hibr/apps" \
		 "${XDG_DATA_HOME:-$HOME/.local/share}/hibr/apps" \
		 "${HIBR_SYSDIR:-/var/lib/hibr}/apps" \
		 /usr/share/hibr/apps; do
		[ -n "$d" ] || continue
		for f in "$d/$want" "$d"/*/"$want"; do		# the catalogue may file an app in a submenu folder
			[ -f "$f" ] && { ret "$f"; return 0; }
		done
	done
	return 1
}

if ! script := find_script; then
	echo "$name: its script is not installed. Fetch it from the catalogue:" >&2
	echo "$name:     catalogue install cli/$name        (for this user)" >&2
	echo "$name:     sudo catalogue --system install cli/$name        (for the machine, and for the services)" >&2
	exit 127
fi
exec "$HIBR" "$script" "$@"			# $HIBR: the hibr this was started under, not whichever comes first on PATH

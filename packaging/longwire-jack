#!/usr/bin/hibr
# SPDX-License-Identifier: GPL-3.0-or-later
#
# longwire-jack --remove TAP [UID] -- the other way: stop the DHCP client of ours on TAP, if any, and delete the device, if it is the user's own.
# longwire-jack --address A.B.C.D/N --via GATEWAY --routes NET/PREFIX[,...] TAP [UID] -- the same, and routes to those networks through a gateway
# that is on the line (docs/adr/0044): a router the jack reaches directly. Never the default route, nothing wider than a /8, nothing the jack reaches anyway.
# longwire-jack --address A.B.C.D/N --via GATEWAY --everything TAP [UID] -- everything through the line (docs/adr/0045): the default route goes into a table
# of the jack's own (7700 + N for lwN), which two rules put in front of the machine's own default route; the machine's own routes to its own networks still
# win, and its own default route is never touched. The routes through the jack are skipped by the kernel when the jack has no carrier, which is when no
# node holds it, so a node that stops or crashes leaves the machine on its own road, not on none; the helper checks that before it adds anything. Run
# without --everything, it takes its rules away if they are there.
# With --dns A.B.C.D as well, the machine asks that name server, through the line, for every name (docs/adr/0047): set on the jack in systemd-resolved, which
# passes over a device with no carrier as the kernel does, so names come back to the machine's own name server whenever the node is gone.
# longwire-jack [--address A.B.C.D/N | --dhcp] TAP [UID] -- as root, make the tap device TAP (a "jack") and give it to the user who asked, then
# bring it up, with the address if one is given, or with a DHCP client started on it (so that nobody runs `ip addr` or `dhclient` by hand). The
# client keeps asking until the line answers, so the tunnel need not be up yet; it sets the address and the network route only, never a
# default route or a name server, so that a line cannot take over the machine's traffic.
# This is the one privileged step a node on a single machine needs. A person never runs it by hand: `longwire jack` and the Control
# Panel's Turn on run it through pkexec (polkit's action org.longwire.jack names this file), which asks for a password in the
# desktop. pkexec sets PKEXEC_UID; run as root by hand, pass the user as the second argument. It makes nothing but a device called
# lw0 to lw99, owned by that user, with an IPv4 address on it if asked, and does nothing else: the node itself never runs as root
# (docs/adr/0004).
#
# It is a hibr script like the rest of longwire (docs/adr/0041). As root, hibr consults only its install directory for modules and reads
# nothing of the caller's environment for them; pkexec cleans the environment besides. The LONGWIRE_* variables below are for the tests.

fn fail(msg, int code = 2) {
	echo "longwire-jack: $msg" >&2
	exit $code
}

addr=
dhcp=
remove=
via=
routes=
everything=
dns=
while [ $# -gt 0 ]; do
	case $1 in
	--address)
		[ $# -ge 2 ] || fail "--address wants A.B.C.D/N"
		addr=$2
		shift 2 ;;
	--dhcp) dhcp=1; shift ;;
	--remove) remove=1; shift ;;
	--everything) everything=1; shift ;;
	--dns)
		[ $# -ge 2 ] || fail "--dns wants a name server's address"
		dns=$2
		shift 2 ;;
	--via)
		[ $# -ge 2 ] || fail "--via wants the gateway's address"
		via=$2
		shift 2 ;;
	--routes)
		[ $# -ge 2 ] || fail "--routes wants networks like 192.168.150.0/24, separated by commas"
		routes=$2
		shift 2 ;;
	*) break ;;
	esac
done
[ -z "$addr" ] || [ -z "$dhcp" ] || fail "an address or --dhcp, not both"
[ -z "$remove" ] || [ -z "$addr$dhcp" ] || fail "--remove takes no address and no --dhcp"
tap=${1:-lw0}
uid=${PKEXEC_UID:-${2:-}}

[[ $tap =~ ^lw[0-9]{1,2}$ ]] || fail "a jack is called lw0 to lw99, not '$tap'"
[[ $uid =~ ^[0-9]+$ ]] || fail "no user to give it to (pass a uid, or run it through pkexec)"
[ "$uid" -ne 0 ] || fail "a jack owned by root would need a node that runs as root"

# Everything through the line: the jack's own table and the two rules in front of the machine's default route (docs/adr/0045).
sys=${LONGWIRE_SYSNET:-/sys/class/net}
proc=${LONGWIRE_PROCNET:-/proc/sys/net}
table=$(( 7700 + ${tap#lw} ))
fn rules_off() {
	local f
	for f in 4 6; do
		if ip -$f rule show pref 7701 2> /dev/null | grep -qw "lookup $table"; then
			ip -$f rule del pref 7701 2> /dev/null
			ip -$f rule del pref 7700 2> /dev/null
			ip -$f route flush table "$table" 2> /dev/null
		fi
	done
}

if [ -n "$remove" ]; then
	[ -d "$sys/$tap" ] || { echo "longwire-jack: $tap is not there; nothing to remove"; exit 0; }
	owner=
	read -r owner < "$sys/$tap/owner" 2> /dev/null
	[ "$owner" = "$uid" ] || fail "$tap is not this user's jack (owner ${owner:-unknown}); not removing it" 3
	rundir=${LONGWIRE_RUN:-/run/longwire}
	pidf=$rundir/dhcp-$tap.pid
	if [ -r "$pidf" ]; then			# a DHCP client of ours on it: stop it first
		old=
		read -r old < "$pidf"
		if [[ $old =~ ^[0-9]+$ ]]; then
			comm=
			read -r comm < "/proc/$old/comm" 2> /dev/null
			case $comm in dhclient | dhcpcd | udhcpc) kill "$old" 2> /dev/null ;; esac
		fi
	elif command -v dhcpcd > /dev/null; then
		dhcpcd -k "$tap" > /dev/null 2>&1
	fi
	rm -f "$pidf" "$rundir/dhcp-hook-$tap" "$rundir/dhcp-$tap.leases"
	rules_off
	ip link delete "$tap" || exit 1
	echo "longwire-jack: $tap is removed"
	exit 0
fi

if [ -n "$addr" ]; then
	# a plain IPv4 host address with a prefix of 8 to 30: four numbers up to 255, no leading zeros, a slash, the prefix; not 0., 127., or above 223.
	octet='(0|[1-9][0-9]{0,2})'
	[[ $addr =~ ^$octet\.$octet\.$octet\.$octet/([0-9]{1,2})$ ]] || fail "'$addr' is not an address like 10.77.0.2/24"
	o1=${M[1]}; o2=${M[2]}; o3=${M[3]}; o4=${M[4]}; pre=${M[5]}
	[ "$o1" -le 255 ] && [ "$o2" -le 255 ] && [ "$o3" -le 255 ] && [ "$o4" -le 255 ] || fail "'$addr' is not an address like 10.77.0.2/24"
	[ "$pre" -ge 8 ] && [ "$pre" -le 30 ] || fail "the prefix of '$addr' is 8 to 30"
	[ "$o1" -ne 0 ] && [ "$o1" -ne 127 ] && [ "$o1" -le 223 ] || fail "'$addr' is not a usable host address"
fi

# Routes through a gateway on the line, checked before anything is changed: the gateway on the jack's own network, each route a real network no wider than a /8,
# none the default route, none overlapping the jack's own network. (The engine keeps its own traffic off whatever is routed here: docs/adr/0044.)
rl=()
[ -z "$routes" ] || [ -n "$via" ] || fail "--routes and --via go together: the networks, and the gateway on the line that reaches them"
[ -z "$everything" ] || [ -n "$via" ] || fail "--everything goes through a gateway on the line: name it with --via"
[ -z "$via" ] || [ -n "$routes$everything" ] || fail "--via is the gateway for --routes or --everything: give one of them"
if [ -n "$dns" ]; then
	[ -n "$everything" ] || fail "--dns goes with --everything: names through the line, with everything else"
	octet='(0|[1-9][0-9]{0,2})'
	[[ $dns =~ ^$octet\.$octet\.$octet\.$octet$ ]] || fail "--dns '$dns' is not an address like 192.168.152.254"
	[ "${M[1]}" -le 255 ] && [ "${M[2]}" -le 255 ] && [ "${M[3]}" -le 255 ] && [ "${M[4]}" -le 255 ] || fail "--dns '$dns' is not an address"
	[ "${M[1]}" -ne 0 ] && [ "${M[1]}" -ne 127 ] && [ "${M[1]}" -lt 224 ] || fail "--dns '$dns' is not a name server that can be reached through the line"
fi
if [ -n "$via" ]; then
	[ -n "$addr" ] || fail "routes need the jack's own address (--address); with DHCP the gateway's network is not known in advance"
	octet='(0|[1-9][0-9]{0,2})'
	[[ $via =~ ^$octet\.$octet\.$octet\.$octet$ ]] || fail "--via '$via' is not an address like 192.168.152.254"
	g1=${M[1]}; g2=${M[2]}; g3=${M[3]}; g4=${M[4]}
	[ "$g1" -le 255 ] && [ "$g2" -le 255 ] && [ "$g3" -le 255 ] && [ "$g4" -le 255 ] || fail "--via '$via' is not an address"
	full=4294967295
	mask=$(( (full << (32 - pre)) & full ))
	aint=$(( o1 * 16777216 + o2 * 65536 + o3 * 256 + o4 ))
	gint=$(( g1 * 16777216 + g2 * 65536 + g3 * 256 + g4 ))
	net=$(( aint & mask ))
	bc=$(( net | (~mask & full) ))
	[ $(( gint & mask )) -eq "$net" ] || fail "the gateway $via is not on the jack's network ($addr): it has to be a machine the line reaches directly"
	[ "$gint" -ne "$aint" ] || fail "the gateway cannot be this machine's own address"
	[ "$gint" -ne "$net" ] && [ "$gint" -ne "$bc" ] || fail "the gateway cannot be the network's first or last address"
	[ -n "$routes" ] && read -r -a rl <<< "${routes//,/ }"
	[ -z "$routes" ] || [ "${#rl[@]}" -ge 1 ] && [ "${#rl[@]}" -le 16 ] || fail "1 to 16 networks in --routes"
	for r in "${rl[@]}"; do
		[[ $r =~ ^$octet\.$octet\.$octet\.$octet/([0-9]{1,2})$ ]] || fail "'$r' is not a network like 192.168.150.0/24"
		r1=${M[1]}; r2=${M[2]}; r3=${M[3]}; r4=${M[4]}; rp=${M[5]}
		[ "$r1" -le 255 ] && [ "$r2" -le 255 ] && [ "$r3" -le 255 ] && [ "$r4" -le 255 ] || fail "'$r' is not a network like 192.168.150.0/24"
		[ "$rp" -ge 8 ] && [ "$rp" -le 32 ] || fail "'$r': a prefix of 8 to 32. The default route, and anything wider than a /8, is not offered (docs/adr/0044)"
		[ "$r1" -ne 0 ] && [ "$r1" -ne 127 ] && [ "$r1" -lt 224 ] || fail "'$r' is not a network that can be routed"
		[ "$r1" -ne 169 ] || [ "$r2" -ne 254 ] || fail "'$r' is link-local: it is never routed"
		rmask=$(( (full << (32 - rp)) & full ))
		rint=$(( r1 * 16777216 + r2 * 65536 + r3 * 256 + r4 ))
		[ $(( rint & rmask )) -eq "$rint" ] || fail "'$r' has host bits set: write the network's first address, like 192.168.150.0/24"
		rend=$(( rint | (~rmask & full) ))
		if [ "$rint" -le "$bc" ] && [ "$net" -le "$rend" ]; then
			fail "'$r' overlaps the jack's own network ($addr), which the line reaches already with no route"
		fi
	done
fi

if [ -n "$everything" ]; then		# one device at a time has everything, and the two places in the rules must be free or ours
	held=$(ip -4 rule show pref 7701 2> /dev/null)
	if [ -n "$held" ] && ! printf '%s\n' "$held" | grep -qw "lookup $table"; then
		fail "something else already takes everything ($held); turn it off there first" 3
	fi
	held=$(ip -4 rule show pref 7700 2> /dev/null)
	if [ -n "$held" ] && ! printf '%s\n' "$held" | grep -q "suppress_prefixlength 0"; then
		fail "the place in the rules longwire uses (7700) is taken by something else: $held" 3
	fi
fi

if [ ! -d "$sys/$tap" ]; then
	ip tuntap add dev "$tap" mode tap user "$uid" || exit 1
fi
ip link set "$tap" mtu 1400 up || exit 1
if [ -n "$addr" ]; then
	ip addr replace "$addr" dev "$tap" || exit 1
fi
for r in "${rl[@]}"; do
	ip route replace "$r" via "$via" dev "$tap" || exit 1
done
if [ -n "$everything" ]; then
	# The safety net first: a jack that no node holds has no carrier, and the kernel is told to skip routes through a device without one. Checked
	# here, with no node on the jack yet, because everything else rests on it.
	car=$(ip -o link show dev "$tap" 2> /dev/null)
	[[ $car =~ NO-CARRIER ]] || fail "the jack $tap has carrier with no node on it, or a node is on it now: turn longwire off first. Everything through the line is only put on a jack whose carrier goes when its node does, so that a node that stops never leaves the machine without a road" 3
	echo 1 > "$proc/ipv4/conf/$tap/ignore_routes_with_linkdown" || fail "cannot tell the kernel to skip $tap's routes when it has no carrier; not going on" 3
	fams=(4)
	if [ -d "$proc/ipv6/conf/$tap" ] && echo 1 > "$proc/ipv6/conf/$tap/ignore_routes_with_linkdown"; then
		fams+=(6)
	fi
	ip route replace default via "$via" dev "$tap" table "$table" || exit 1
	if [ "${#fams[@]}" -gt 1 ]; then	# IPv6 goes into the line too, where nothing answers it unless the far side routes it: it does not leak past the line
		ip -6 route replace default dev "$tap" table "$table" || exit 1
	fi
	for f in "${fams[@]}"; do
		ip -$f rule show pref 7700 2> /dev/null | grep -q "suppress_prefixlength 0" || ip -$f rule add pref 7700 lookup main suppress_prefixlength 0 || exit 1
		ip -$f rule show pref 7701 2> /dev/null | grep -qw "lookup $table" || ip -$f rule add pref 7701 lookup "$table" || exit 1
	done
else
	rules_off
fi
# Names (docs/adr/0047): set on the jack in systemd-resolved, or taken off it. Without resolved, said plainly; everything else stands.
names=
if command -v resolvectl > /dev/null; then
	if [ -n "$dns" ]; then
		resolvectl dns "$tap" "$dns" && resolvectl domain "$tap" '~.' && resolvectl default-route "$tap" yes || fail "could not set the name server $dns on $tap in systemd-resolved" 3
		names=", names through $dns"
	else
		resolvectl revert "$tap" 2> /dev/null
	fi
elif [ -n "$dns" ]; then
	echo "longwire-jack: names still go to this machine's own name server: asking $dns through the line needs systemd-resolved (resolvectl), which is not here" >&2
fi

client=
if [ -n "$dhcp" ]; then
	rundir=${LONGWIRE_RUN:-/run/longwire}
	mkdir -p "$rundir" && chmod 755 "$rundir" || exit 1
	pidf=$rundir/dhcp-$tap.pid
	hook=$rundir/dhcp-hook-$tap
	if [ -r "$pidf" ]; then			# a client of ours from before: stop it, so there is one
		old=
		read -r old < "$pidf"
		if [[ $old =~ ^[0-9]+$ ]]; then
			comm=
			read -r comm < "/proc/$old/comm" 2> /dev/null
			case $comm in dhclient | dhcpcd | udhcpc) kill "$old" 2> /dev/null ;; esac
		fi
		rm -f "$pidf"
	fi

	# The system's own script does the work (address, network route) once this hook has taken out the default route, the name servers and
	# the rest. The hook is a hibr script too: its interpreter is the one running now.
	fn mkhook(real) {
		local me
		[ -x "$real" ] || fail "the DHCP client's script $real is not there" 3
		me=$HIBR			# the hibr this was started under, not whichever comes first on PATH
		printf '#!%s\nunset new_routers new_domain_name_servers new_domain_search new_domain_name new_ntp_servers new_static_routes new_classless_static_routes router dns domain search ntpsrv staticroutes\nexec %s "$@"\n' "$me" "$real" > "$hook" || exit 1
		chmod 755 "$hook"
	}

	real=
	if command -v dhclient > /dev/null; then
		real=${LONGWIRE_DHCP_SCRIPT:-}
		if [ -z "$real" ]; then
			for f in /sbin/dhclient-script /usr/sbin/dhclient-script; do
				[ -x "$f" ] && { real=$f; break; }
			done
		fi
		mkhook "$real"
		dhclient -nw -pf "$pidf" -lf "$rundir/dhcp-$tap.leases" -sf "$hook" "$tap" || exit 1
		client=dhclient
	elif command -v dhcpcd > /dev/null; then
		dhcpcd -k "$tap" > /dev/null 2>&1
		dhcpcd -b -G -C resolv.conf -C ntp.conf "$tap" || exit 1
		client=dhcpcd
	elif command -v udhcpc > /dev/null; then
		real=${LONGWIRE_DHCP_SCRIPT:-}
		if [ -z "$real" ]; then
			for f in /usr/share/udhcpc/default.script /etc/udhcpc/default.script; do
				[ -x "$f" ] && { real=$f; break; }
			done
		fi
		mkhook "$real"
		udhcpc -b -i "$tap" -p "$pidf" -s "$hook" || exit 1
		client=udhcpc
	else
		fail "no DHCP client found: install isc-dhcp-client, dhcpcd or udhcpc (busybox)" 3
	fi
fi
echo "longwire-jack: $tap is up, owned by user $uid${addr:+, address $addr}${client:+, $client started on it}${routes:+, routes to $routes via $via}${everything:+, everything through $via}$names"

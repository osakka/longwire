# longwire site node, splicing the LAN on the NIC named after the @:  systemctl enable --now longwire@eth0
# Configure /etc/longwire/eth0.conf with one line, for example
#     ARGS="--switchboard HOST:PORT/KEY --answer known"
# The script comes from the catalogue, for the machine:  sudo catalogue --system install cli/longwire
# AF_NETLINK is for listing the interface addresses (candidates); each instance has a state directory of its own, so two NICs
# are two identities. The script is read from the machine's scope only: this service's own writable home is never searched.
# The control socket is /run/longwire/%i/ctl, mode 0660, group longwire: the people in that group (usermod -aG longwire NAME) can
# dial, hang up and watch this node from the hibr desktop or the command line, and read no key (docs/adr/0032).
# CAP_NET_RAW opens the packet socket and is the only privilege; `lw start` clears every capability the moment it is open.
[Unit]
Description=longwire site node (splice on %I)
Documentation=file:///usr/share/doc/longwire/CLI.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/longwire/%i.conf

[Service]
Type=simple
EnvironmentFile=/etc/longwire/%i.conf
Environment=HOME=/var/lib/longwire/%i
Environment=LONGWIRE_SCRIPTS=/var/lib/hibr/cli
Environment=LONGWIRE_MOD=/usr/lib/hibr/longwire.so
Environment=LW_SOCK=/run/longwire/%i/ctl
ExecStart=/usr/bin/longwire up --splice %i --group longwire $ARGS
DynamicUser=yes
Group=longwire
RuntimeDirectory=longwire/%i
RuntimeDirectoryMode=0750
StateDirectory=longwire/%i
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK

[Install]
WantedBy=multi-user.target
